{% extends 'base_back.html.twig' %}

{% block title %}Create ticket - EcoSpot{% endblock %}
{% block page_title %}Create a ticket{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .eco-form-card {
            border-radius: 16px;
            border: 1px solid rgba(45, 106, 79, 0.1);
            background: #ffffff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .eco-form-header {
            background: linear-gradient(135deg, var(--eco-forest) 0%, var(--eco-leaf) 100%);
            padding: 1.5rem 2rem;
            color: white;
            border-bottom: 3px solid var(--eco-mint);
        }

        .eco-form-header h4 {
            color: white;
            margin: 0;
            font-weight: 600;
        }

        .eco-form-body {
            padding: 2rem;
        }

        .form-label {
            font-weight: 600;
            color: var(--eco-dark-green);
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ced4da;
            padding: 0.6rem 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--eco-mint);
            box-shadow: 0 0 0 0.25rem rgba(82, 183, 136, 0.25);
        }

        .eco-btn-submit {
            background: linear-gradient(135deg, var(--eco-forest) 0%, var(--eco-leaf) 100%);
            color: white !important;
            border: none;
            border-radius: 8px;
            padding: 0.7rem 2rem;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(45, 106, 79, 0.2);
            display: inline-flex;
            align-items: center;
        }

        .eco-btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(45, 106, 79, 0.3);
            background: linear-gradient(135deg, var(--eco-dark-green) 0%, var(--eco-forest) 100%);
        }

        .location-search-wrap .input-group-text {
            background-color: var(--eco-cream);
            color: var(--eco-forest);
            border-color: #ced4da;
            border-right: none;
        }

        .location-search-wrap input.form-control {
            border-left: none;
        }

        .location-search-wrap input.form-control:focus {
            border-color: var(--eco-mint);
            box-shadow: none;
        }
        
        .location-search-wrap:focus-within {
            box-shadow: 0 0 0 0.25rem rgba(82, 183, 136, 0.25);
            border-radius: 8px;
        }
        
        .location-search-wrap:focus-within .input-group-text,
        .location-search-wrap:focus-within input.form-control {
            border-color: var(--eco-mint);
        }

        /* Task Collection Styles */
        .consignes-container {
            background: #f8fcf9;
            border-radius: 12px;
            padding: 1.5rem;
            border: 1px dashed var(--eco-mint);
        }
        .consigne-item {
            background: white;
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
            transition: all 0.2s ease;
            position: relative;
        }
        .consigne-item:hover {
            box-shadow: 0 6px 15px rgba(0,0,0,0.05);
            border-color: var(--eco-mint);
        }
        .consigne-number {
            width: 28px;
            height: 28px;
            background: var(--eco-mint);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
            flex-shrink: 0;
        }
        .remove-consigne {
            color: #ef4444;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s;
        }
        .remove-consigne:hover {
            opacity: 1;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card eco-form-card">
                <div class="eco-form-header d-flex align-items-center">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fas fa-leaf text-success fs-4"></i>
                    </div>
                    <div>
                        <h4>Submit an Environmental Ticket</h4>
                        <p class="mb-0 text-white-50 small">Report an issue or suggest an improvement</p>
                    </div>
                </div>

                <div class="card-body eco-form-body">
                    <div class="alert alert-light border-start border-4 border-success bg-light mb-4 text-muted">
                        <i class="fas fa-info-circle text-success me-2"></i> Describe your environmental observation. You must <strong>search and select a location</strong> so we can show the 7-day weather forecast on your ticket.
                    </div>

                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            {{ form_label(form.title, 'Ticket Title', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.title) }}
                            <div class="form-text text-muted small"><i class="fas fa-pen-nib me-1"></i> Give your report a clear, concise name.</div>
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(form.description, 'Details & Description', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.description) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="col-12">
                            {{ form_label(form.imageFile, 'Upload Photo (Optional)', {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-camera text-muted"></i></span>
                                {{ form_widget(form.imageFile) }}
                            </div>
                            {{ form_errors(form.imageFile) }}
                        </div>

                        <div class="col-12">
                            <label class="form-label">Location <span class="text-danger">*</span></label>
                            
                            <div id="ticket-location-search-wrap" class="mb-2 position-relative">
                                <div class="input-group location-search-wrap">
                                    <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                    <input type="text" id="ticket-place-search" class="form-control" placeholder="Search for a place (e.g. Paris, Central Park)" autocomplete="off">
                                    <button type="button" class="btn btn-outline-success px-4" id="ticket-location-search-btn">Search</button>
                                </div>
                                <div id="ticket-geocode-results" class="list-group mt-1 position-absolute start-0 w-100 shadow-lg rounded-3 border-0" style="z-index: 1050; display: none; max-height: 250px; overflow-y: auto; background: #fff;"></div>
                            </div>
                            
                            <div id="ticket-location-selected" class="d-none">
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white border-success"><i class="fas fa-check-circle"></i></span>
                                    <input type="text" id="ticket_location_display" class="form-control bg-light fw-semibold text-success" readonly placeholder="No location selected">
                                    <button type="button" class="btn btn-outline-secondary" id="ticket-location-clear"><i class="fas fa-times me-1"></i> Change</button>
                                </div>
                            </div>
                            
                            <div class="form-text text-muted small mt-2"><i class="fas fa-cloud-sun me-1"></i> Selecting a precise location enables the real-time weather integration.</div>
                            
                            {{ form_widget(form.location, { attr: { class: 'd-none' } }) }}
                            {{ form_widget(form.latitude) }}
                            {{ form_widget(form.longitude) }}
                            {{ form_errors(form.location) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_label(form.priority, 'Priority Level', {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-exclamation-triangle text-warning"></i></span>
                                {{ form_widget(form.priority) }}
                            </div>
                            {{ form_errors(form.priority) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_label(form.domain, 'Action Domain', {'label_attr': {'class': 'form-label'}}) }}
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-layer-group text-primary"></i></span>
                                {{ form_widget(form.domain) }}
                            </div>
                            {{ form_errors(form.domain) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="mb-0 text-success"><i class="fas fa-tasks me-2"></i> Tasks & Instructions</h5>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="ai-suggest-tasks">
                                    <i class="fas fa-magic me-1"></i> AI Suggest
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" id="add-consigne">
                                    <i class="fas fa-plus me-1"></i> Add Task
                                </button>
                            </div>
                        </div>
                        
                        {% set task_prototype %}
                            <div class="consigne-item d-flex gap-3 align-items-start">
                                <div class="consigne-number"></div>
                                <div class="flex-grow-1">
                                    <div class="row g-2">
                                        <div class="col-8">{{ form_widget(form.consignes.vars.prototype.description) }}</div>
                                        <div class="col-4">{{ form_widget(form.consignes.vars.prototype.difficulty) }}</div>
                                    </div>
                                    {{ form_widget(form.consignes.vars.prototype.position) }}
                                </div>
                                <button type="button" class="btn btn-link remove-consigne p-0 mt-2">
                                    <i class="fas fa-times-circle fs-5"></i>
                                </button>
                            </div>
                        {% endset %}

                        <div id="consignes-list" class="consignes-container" 
                             data-prototype="{{ task_prototype|e('html_attr') }}"
                             data-index="{{ form.consignes|length }}">
                            
                            {% if form.consignes|length == 0 %}
                                <div id="no-consignes-msg" class="text-center py-4 text-muted">
                                    <i class="fas fa-clipboard-list d-block fs-2 mb-2 opacity-25"></i>
                                    <p class="mb-0">No specific tasks added yet. These help anyone who wants to resolve this ticket.</p>
                                </div>
                            {% endif %}

                            {% for consigne in form.consignes %}
                                <div class="consigne-item d-flex gap-3 align-items-start">
                                    <div class="consigne-number">{{ loop.index }}</div>
                                    <div class="flex-grow-1">
                                        <div class="row g-2">
                                            <div class="col-8">
                                                {{ form_widget(consigne.description) }}
                                            </div>
                                            <div class="col-4">
                                                {{ form_widget(consigne.difficulty) }}
                                            </div>
                                        </div>
                                        {{ form_widget(consigne.position) }}
                                    </div>
                                    <button type="button" class="btn btn-link remove-consigne p-0 mt-2">
                                        <i class="fas fa-times-circle fs-5"></i>
                                    </button>
                                </div>
                            {% endfor %}
                            
                            {# Hidden widget for Symfony to handle the collection #}
                            <div class="d-none">
                                {{ form_widget(form.consignes) }}
                            </div>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="{{ path('ticket_my_list') }}" class="btn btn-light border text-muted px-4 fw-semibold rounded-3">Cancel</a>
                        <button type="submit" class="eco-btn-submit">
                            <i class="fas fa-paper-plane me-2"></i> Submit Ticket
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const locationInput = document.querySelector('#ticket_location');
        const locationDisplay = document.getElementById('ticket_location_display');
        const latInput = document.querySelector('#ticket_latitude');
        const lngInput = document.querySelector('#ticket_longitude');
        const searchInput = document.getElementById('ticket-place-search');
        const searchWrap = document.getElementById('ticket-location-search-wrap');
        const selectedWrap = document.getElementById('ticket-location-selected');
        const searchBtn = document.getElementById('ticket-location-search-btn');
        const clearBtn = document.getElementById('ticket-location-clear');
        const resultsEl = document.getElementById('ticket-geocode-results');

        function doSearch() {
            const q = searchInput && searchInput.value ? searchInput.value.trim() : '';
            if (q.length < 2) { resultsEl.style.display = 'none'; return; }
            resultsEl.innerHTML = '<div class="list-group-item">Searching…</div>';
            resultsEl.style.display = 'block';
            const url = '{{ path('api_geocode') }}?q=' + encodeURIComponent(q);
            fetch(url, { credentials: 'same-origin' })
                .then(function(r) {
                    if (!r.ok) throw new Error('API returned ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    if (!Array.isArray(data)) { resultsEl.innerHTML = '<div class="list-group-item text-danger">Invalid response</div>'; return; }
                    if (!data.length) { resultsEl.innerHTML = '<div class="list-group-item">No results. Try another search (e.g. city name or address).</div>'; return; }
                    resultsEl.innerHTML = data.map(function(r) {
                        var name = (r.display_name || '').replace(/"/g, '&quot;').replace(/</g, '&lt;');
                        return '<a href="#" class="list-group-item list-group-item-action" data-name="' + name + '" data-lat="' + (r.lat || '') + '" data-lon="' + (r.lon || '') + '">' + (r.display_name || '') + '</a>';
                    }).join('');
                })
                .catch(function(err) {
                    resultsEl.innerHTML = '<div class="list-group-item text-danger">Search failed: ' + (err.message || 'check connection') + '. Try again later.</div>';
                });
        }

        function selectPlace(name, lat, lon) {
            if (locationInput) locationInput.value = name || '';
            if (locationDisplay) locationDisplay.value = name || '';
            if (latInput) latInput.value = lat || '';
            if (lngInput) lngInput.value = lon || '';
            resultsEl.style.display = 'none';
            searchWrap.classList.add('d-none');
            selectedWrap.classList.remove('d-none');
        }

        function clearLocation() {
            if (locationInput) locationInput.value = '';
            if (locationDisplay) locationDisplay.value = '';
            if (latInput) latInput.value = '';
            if (lngInput) lngInput.value = '';
            searchWrap.classList.remove('d-none');
            selectedWrap.classList.add('d-none');
            if (searchInput) searchInput.value = '';
        }

        if (searchBtn) searchBtn.addEventListener('click', doSearch);
        if (searchInput) searchInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });
        if (clearBtn) clearBtn.addEventListener('click', clearLocation);

        resultsEl.addEventListener('click', function(e) {
            e.preventDefault();
            var a = e.target.closest('a[data-lat]');
            if (!a) return;
            selectPlace(a.getAttribute('data-name'), a.getAttribute('data-lat'), a.getAttribute('data-lon'));
        });

        // Consignes Collection Logic
        const addBtn = document.getElementById('add-consigne');
        const list = document.getElementById('consignes-list');
        const noMsg = document.getElementById('no-consignes-msg');
        let index = parseInt(list.dataset.index);

        function updatePositions() {
            const items = list.querySelectorAll('.consigne-item');
            items.forEach((item, idx) => {
                const number = item.querySelector('.consigne-number');
                if (number) number.textContent = idx + 1;
                const posInput = item.querySelector('.consigne-position');
                if (posInput) posInput.value = idx;
            });
            if (noMsg) {
                noMsg.style.display = items.length === 0 ? 'block' : 'none';
            }
        }

        addBtn.addEventListener('click', function() {
            const prototype = list.dataset.prototype;
            const newForm = prototype.replace(/__name__/g, index);
            index++;
            list.dataset.index = index;

            const div = document.createElement('div');
            div.className = 'consigne-item d-flex gap-3 align-items-start';
            div.innerHTML = `
                <div class="consigne-number"></div>
                <div class="flex-grow-1">${newForm}</div>
                <button type="button" class="btn btn-link remove-consigne p-0 mt-2">
                    <i class="fas fa-times-circle fs-5"></i>
                </button>
            `;
            
            list.appendChild(div);
            updatePositions();
        });

        list.addEventListener('click', function(e) {
            const btn = e.target.closest('.remove-consigne');
            if (btn) {
                btn.closest('.consigne-item').remove();
                updatePositions();
            }
        });

        // AI Suggest Logic
        const aiBtn = document.getElementById('ai-suggest-tasks');
        const titleInput = document.getElementById('ticket_title');
        const descInput = document.getElementById('ticket_description');

        aiBtn.addEventListener('click', async function() {
            const title = titleInput.value.trim();
            const description = descInput.value.trim();

            if (description.length < 10) {
                alert('Please provide a longer description (at least 10 chars) so the AI can understand the context.');
                return;
            }

            aiBtn.disabled = true;
            aiBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Thinking...';

            try {
                const response = await fetch('{{ path('api_ticket_ai_tasks') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, description })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to generate tasks');
                }

                const responseData = await response.json();
                const tasks = responseData.tasks || [];
                const suggestedPriority = responseData.priority;

                if (tasks.length === 0) {
                    alert('AI could not generate specific tasks. Try adjusting your description.');
                } else {
                    // Update Ticket Priority
                    const prioritySelect = document.getElementById('ticket_priority');
                    if (prioritySelect && suggestedPriority) {
                        prioritySelect.value = suggestedPriority;
                        
                        // Add Magic Effect to parent container (input-group)
                        const priorityContainer = prioritySelect.closest('.input-group');
                        if (priorityContainer) {
                            priorityContainer.classList.add('ai-magic-priority');
                            priorityContainer.classList.add('ai-highlight');
                            
                            // Remove highlight after animation
                            setTimeout(() => priorityContainer.classList.remove('ai-highlight'), 1500);

                            // Remove magic when user manually changes it
                            const removePriorityMagic = () => {
                                priorityContainer.classList.remove('ai-magic-priority');
                                prioritySelect.removeEventListener('change', removePriorityMagic);
                            };
                            prioritySelect.addEventListener('change', removePriorityMagic);
                        }
                    }

                    tasks.forEach((taskObj, i) => {
                        const taskText = typeof taskObj === 'string' ? taskObj : taskObj.description;
                        const taskDifficulty = typeof taskObj === 'object' ? taskObj.difficulty : 'MEDIUM';

                        const prototype = list.dataset.prototype;
                        const newForm = prototype.replace(/__name__/g, index);
                        index++;
                        list.dataset.index = index;

                        const div = document.createElement('div');
                        div.innerHTML = newForm;
                        const finalDiv = div.firstElementChild;
                        
                        // Add Magic Effect
                        finalDiv.classList.add('ai-magic-item');
                        
                        // Sequential delay for "magic" appearance
                        setTimeout(() => {
                            list.appendChild(finalDiv);
                            
                            const input = finalDiv.querySelector('input[type="text"]');
                            const diffSelect = finalDiv.querySelector('.difficulty-select');

                            if (input) {
                                input.value = taskText;
                                // Remove magic on interaction
                                const removeMagic = () => {
                                    finalDiv.classList.remove('ai-magic-item');
                                    input.removeEventListener('input', removeMagic);
                                    if (diffSelect) diffSelect.removeEventListener('change', removeMagic);
                                };
                                input.addEventListener('input', removeMagic);
                                if (diffSelect) diffSelect.addEventListener('change', removeMagic);
                            }

                            if (diffSelect && taskDifficulty) {
                                diffSelect.value = taskDifficulty;
                            }
                            updatePositions();
                        }, i * 150);
                    });
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                aiBtn.disabled = false;
                aiBtn.innerHTML = '<i class="fas fa-magic me-1"></i> AI Suggest';
            }
        });
    });
    </script>
{% endblock %}
