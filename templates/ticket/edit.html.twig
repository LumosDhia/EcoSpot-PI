{% extends 'base_back.html.twig' %}

{% block title %}Edit ticket - EcoSpot{% endblock %}
{% block page_title %}Edit ticket (sent back for modification){% endblock %}

{% block body %}
    <div class="card mb-3">
        <div class="card-header bg-info text-white">Admin note</div>
        <div class="card-body">
            <p class="mb-0">{{ ticket.adminNotes ?? 'No note provided.' }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <p class="text-muted mb-3">You must <strong>search and select a location</strong> from the list so we can show the 7-day weather (only places supported by the weather API are accepted).</p>
            {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.description) }}
            
            {% if ticket.image %}
                <div class="mb-3">
                    <label class="form-label d-block text-muted small">Current Picture</label>
                    <div class="position-relative d-inline-block">
                        <img src="{{ asset(ticket.image) }}" class="img-thumbnail" alt="Current image" style="max-height: 150px;">
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success shadow-sm">
                            <i class="fas fa-check small"></i>
                        </span>
                    </div>
                    <div class="form-text mt-1">Keep it as is, or upload a new one below to replace it.</div>
                </div>
            {% endif %}

            {{ form_row(form.imageFile) }}
            <div class="mb-3">
                <label class="form-label">Location <span class="text-danger">*</span></label>
                <div id="ticket-location-search-wrap" class="mb-2 position-relative {{ ticket.latitude and ticket.longitude ? 'd-none' : '' }}">
                    <div class="input-group">
                        <input type="text" id="ticket-place-search" class="form-control" placeholder="Search for a place (e.g. Paris, London)" autocomplete="off">
                        <button type="button" class="btn btn-outline-primary" id="ticket-location-search-btn">Search</button>
                    </div>
                    <div id="ticket-geocode-results" class="list-group mt-1 position-absolute start-0 w-100" style="z-index: 1050; display: none; max-height: 220px; overflow-y: auto; background: #fff;"></div>
                </div>
                <div id="ticket-location-selected" class="{{ ticket.latitude and ticket.longitude ? '' : 'd-none' }}">
                    <div class="input-group">
                        <input type="text" id="ticket_location_display" class="form-control bg-light" readonly placeholder="No location selected" value="{{ ticket.location }}">
                        <button type="button" class="btn btn-outline-secondary" id="ticket-location-clear">Change location</button>
                    </div>
                </div>
                <div class="form-text">Choose a place from the search results.</div>
                {{ form_widget(form.location, { attr: { class: 'd-none' } }) }}
                {{ form_widget(form.latitude) }}
                {{ form_widget(form.longitude) }}
                {{ form_errors(form.location) }}
            </div>
            {{ form_row(form.priority) }}
            {{ form_row(form.domain) }}

            <div class="mb-4 mt-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="mb-0 text-info"><i class="fas fa-tasks me-2"></i> Tasks & Instructions</h5>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="ai-suggest-tasks">
                            <i class="fas fa-magic me-1"></i> AI Suggest
                        </button>
                        <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-3" id="add-consigne">
                            <i class="fas fa-plus me-1"></i> Add Task
                        </button>
                    </div>
                </div>
                
                {% set task_prototype %}
                    <div class="consigne-item d-flex gap-3 align-items-start mb-3 p-2 bg-white border rounded shadow-sm">
                        <div class="consigne-number bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; flex-shrink: 0; font-size: 0.8rem;"></div>
                        <div class="flex-grow-1">
                            <div class="row g-2">
                                <div class="col-8">{{ form_widget(form.consignes.vars.prototype.description) }}</div>
                                <div class="col-4">{{ form_widget(form.consignes.vars.prototype.difficulty) }}</div>
                            </div>
                            {{ form_widget(form.consignes.vars.prototype.position) }}
                        </div>
                        <button type="button" class="btn btn-link remove-consigne p-0 text-danger">
                            <i class="fas fa-times-circle fs-5"></i>
                        </button>
                    </div>
                {% endset %}

                <div id="consignes-list" class="consignes-container p-3 border rounded bg-light" 
                     data-prototype="{{ task_prototype|e('html_attr') }}"
                     data-index="{{ form.consignes|length }}">
                    
                    {% for consigne in form.consignes %}
                        <div class="consigne-item d-flex gap-3 align-items-start mb-3 p-2 bg-white border rounded shadow-sm">
                            <div class="consigne-number bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; flex-shrink: 0; font-size: 0.8rem;">{{ loop.index }}</div>
                            <div class="flex-grow-1">
                                <div class="row g-2">
                                    <div class="col-8">
                                        {{ form_widget(consigne.description) }}
                                    </div>
                                    <div class="col-4">
                                        {{ form_widget(consigne.difficulty) }}
                                    </div>
                                </div>
                                {{ form_widget(consigne.position) }}
                            </div>
                            <button type="button" class="btn btn-link remove-consigne p-0 text-danger">
                                <i class="fas fa-times-circle fs-5"></i>
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Resubmit for review</button>
                <a href="{{ path('ticket_my_list') }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const locationInput = document.querySelector('#ticket_location');
        const locationDisplay = document.getElementById('ticket_location_display');
        const latInput = document.querySelector('#ticket_latitude');
        const lngInput = document.querySelector('#ticket_longitude');
        const searchInput = document.getElementById('ticket-place-search');
        const searchWrap = document.getElementById('ticket-location-search-wrap');
        const selectedWrap = document.getElementById('ticket-location-selected');
        const searchBtn = document.getElementById('ticket-location-search-btn');
        const clearBtn = document.getElementById('ticket-location-clear');
        const resultsEl = document.getElementById('ticket-geocode-results');

        function doSearch() {
            const q = searchInput && searchInput.value ? searchInput.value.trim() : '';
            if (q.length < 2) { resultsEl.style.display = 'none'; return; }
            resultsEl.innerHTML = '<div class="list-group-item">Searching…</div>';
            resultsEl.style.display = 'block';
            fetch('{{ path('api_geocode') }}?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                .then(function(r) {
                    if (!r.ok) throw new Error('API returned ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    if (!Array.isArray(data)) { resultsEl.innerHTML = '<div class="list-group-item text-danger">Invalid response</div>'; return; }
                    if (!data.length) { resultsEl.innerHTML = '<div class="list-group-item">No results. Try another search.</div>'; return; }
                    resultsEl.innerHTML = data.map(function(r) {
                        var name = (r.display_name || '').replace(/"/g, '&quot;').replace(/</g, '&lt;');
                        return '<a href="#" class="list-group-item list-group-item-action" data-name="' + name + '" data-lat="' + (r.lat || '') + '" data-lon="' + (r.lon || '') + '">' + (r.display_name || '') + '</a>';
                    }).join('');
                })
                .catch(function(err) {
                    resultsEl.innerHTML = '<div class="list-group-item text-danger">Search failed: ' + (err.message || 'check connection') + '.</div>';
                });
        }

        function selectPlace(name, lat, lon) {
            if (locationInput) locationInput.value = name || '';
            if (locationDisplay) locationDisplay.value = name || '';
            if (latInput) latInput.value = lat || '';
            if (lngInput) lngInput.value = lon || '';
            resultsEl.style.display = 'none';
            searchWrap.classList.add('d-none');
            selectedWrap.classList.remove('d-none');
        }

        function clearLocation() {
            if (locationInput) locationInput.value = '';
            if (locationDisplay) locationDisplay.value = '';
            if (latInput) latInput.value = '';
            if (lngInput) lngInput.value = '';
            searchWrap.classList.remove('d-none');
            selectedWrap.classList.add('d-none');
            if (searchInput) searchInput.value = '';
        }

        if (searchBtn) searchBtn.addEventListener('click', doSearch);
        if (searchInput) searchInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); doSearch(); } });
        if (clearBtn) clearBtn.addEventListener('click', clearLocation);

        // Consignes Collection Logic
        const addBtn = document.getElementById('add-consigne');
        const list = document.getElementById('consignes-list');
        let index = parseInt(list.dataset.index);

        function updatePositions() {
            const items = list.querySelectorAll('.consigne-item');
            items.forEach((item, idx) => {
                const number = item.querySelector('.consigne-number');
                if (number) number.textContent = idx + 1;
                const posInput = item.querySelector('.consigne-position');
                if (posInput) posInput.value = idx;
            });
        }

        addBtn.addEventListener('click', function() {
            const prototype = list.dataset.prototype;
            const newForm = prototype.replace(/__name__/g, index);
            index++;
            list.dataset.index = index;

            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = newForm.trim();
            const newElem = tempDiv.firstElementChild;
            
            list.appendChild(newElem);
            updatePositions();
        });

        list.addEventListener('click', function(e) {
            const btn = e.target.closest('.remove-consigne');
            if (btn) {
                btn.closest('.consigne-item').remove();
                updatePositions();
            }
        });

        // AI Suggest Logic
        const aiBtn = document.getElementById('ai-suggest-tasks');
        const titleInput = document.getElementById('ticket_title');
        const descInput = document.getElementById('ticket_description');

        aiBtn.addEventListener('click', async function() {
            const title = titleInput.value.trim();
            const description = descInput.value.trim();

            if (description.length < 10) {
                alert('Please provide a longer description (at least 10 chars) so the AI can understand the context.');
                return;
            }

            aiBtn.disabled = true;
            aiBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Thinking...';

            try {
                const response = await fetch('{{ path('api_ticket_ai_tasks') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, description })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.error || 'Failed to generate tasks');
                }

                const responseData = await response.json();
                const tasks = responseData.tasks || [];
                const suggestedPriority = responseData.priority;
                
                if (tasks.length === 0) {
                    alert('AI could not generate specific tasks. Try adjusting your description.');
                } else {
                    // Update Ticket Priority
                    const prioritySelect = document.getElementById('ticket_priority');
                    if (prioritySelect && suggestedPriority) {
                        prioritySelect.value = suggestedPriority;
                        
                        // Add Magic Effect to parent container (input-group)
                        const priorityContainer = prioritySelect.closest('.input-group');
                        if (priorityContainer) {
                            priorityContainer.classList.add('ai-magic-priority');
                            priorityContainer.classList.add('ai-highlight');
                            
                            // Remove highlight after animation
                            setTimeout(() => priorityContainer.classList.remove('ai-highlight'), 1500);

                            // Remove magic when user manually changes it
                            const removePriorityMagic = () => {
                                priorityContainer.classList.remove('ai-magic-priority');
                                prioritySelect.removeEventListener('change', removePriorityMagic);
                            };
                            prioritySelect.addEventListener('change', removePriorityMagic);
                        }
                    }

                    tasks.forEach((taskObj, i) => {
                        const taskText = typeof taskObj === 'string' ? taskObj : taskObj.description;
                        const taskDifficulty = typeof taskObj === 'object' ? taskObj.difficulty : 'MEDIUM';

                        const prototype = list.dataset.prototype;
                        const newForm = prototype.replace(/__name__/g, index);
                        index++;
                        list.dataset.index = index;

                        const div = document.createElement('div');
                        div.innerHTML = newForm;
                        const finalDiv = div.firstElementChild;
                        
                        // Add Magic Effect
                        finalDiv.classList.add('ai-magic-item');

                        // Sequential delay for "magic" appearance
                        setTimeout(() => {
                            list.appendChild(finalDiv);
                            
                            const input = finalDiv.querySelector('input[type="text"]');
                            const diffSelect = finalDiv.querySelector('.difficulty-select');

                            if (input) {
                                input.value = taskText;
                                // Remove magic on interaction
                                const removeMagic = () => {
                                    finalDiv.classList.remove('ai-magic-item');
                                    input.removeEventListener('input', removeMagic);
                                    if (diffSelect) diffSelect.removeEventListener('change', removeMagic);
                                };
                                input.addEventListener('input', removeMagic);
                                if (diffSelect) diffSelect.addEventListener('change', removeMagic);
                            }

                            if (diffSelect && taskDifficulty) {
                                diffSelect.value = taskDifficulty;
                            }
                            updatePositions();
                        }, i * 150);
                    });
                }
            } catch (err) {
                alert('Error: ' + err.message);
            } finally {
                aiBtn.disabled = false;
                aiBtn.innerHTML = '<i class="fas fa-magic me-1"></i> AI Suggest';
            }
        });

        resultsEl.addEventListener('click', function(e) {
            e.preventDefault();
            var a = e.target.closest('a[data-lat]');
            if (!a) return;
            selectPlace(a.getAttribute('data-name'), a.getAttribute('data-lat'), a.getAttribute('data-lon'));
        });
    });
    </script>
{% endblock %}
