{% extends public_view|default(false) ? 'base_front.html.twig' : 'base_back.html.twig' %}

{% block title %}{{ ticket.title }} - EcoSpot{% endblock %}
{% block page_title %}{% if not public_view|default(false) %}{{ ticket.title }}{% endif %}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="badge bg-{{ ticket.status.getBadgeClass() }}">{{ ticket.status.getLabel() }}</span>
                <span class="badge bg-{{ ticket.priority.getBadgeClass() }}">{{ ticket.priority.getLabel() }}</span>
                {% if not public_view|default(false) %}
                    <a href="{{ path('ticket_my_list') }}" class="btn btn-sm btn-outline-secondary">← My tickets</a>
                {% else %}
                    <a href="{{ path('public_tickets') }}" class="btn btn-sm btn-outline-secondary">← All tickets</a>
                {% endif %}
            </div>
            <div class="card-body">
                {% if ticket.image %}
                    <div class="mb-3">
                        <img src="{{ asset(ticket.image) }}" alt="{{ ticket.title }}" class="img-fluid rounded" style="max-height: 280px; object-fit: cover;">
                    </div>
                {% endif %}
                <h1 class="h4 card-title">{{ ticket.title }}</h1>
                <p class="text-muted small mb-2">
                    <i class="bi {{ ticket.domain.getIcon() }}"></i> {{ ticket.domain.getLabel() }}
                    &middot; <i class="bi bi-geo-alt"></i> {{ ticket.location }}
                </p>
                <div class="card-text">{{ ticket.description|nl2br }}</div>
                {% if ticket.adminNotes and ticket.status.value == 'SENT_BACK' %}
                    <div class="alert alert-light border mt-3 mb-0">
                        <strong>Admin note:</strong> {{ ticket.adminNotes }}
                    </div>
                {% endif %}
                <p class="small text-muted mt-3 mb-0">Created {{ ticket.createdAt|date('d/m/Y H:i') }}</p>
                {% if forecast|default([])|length > 0 %}
                    <div class="mt-3 mb-3">
                        <h6 class="text-primary"><i class="bi bi-cloud-sun"></i> 7-day weather ({{ ticket.location }})</h6>
                        <div class="d-flex flex-wrap gap-2">
                            {% for day in forecast %}
                                <div class="border rounded px-2 py-1 small" style="min-width: 5rem;">
                                    <div class="fw-bold">{{ day.date|date('d/m') }}</div>
                                    <div>{{ day.temp_min|round(0) }}° – {{ day.temp_max|round(0) }}°C</div>
                                    <div class="text-muted">{{ day.description }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if ticket.status.value == 'PUBLISHED' %}
                    {% if ticket.achievedAt %}
                        <div class="alert alert-success mt-3 mb-0">
                            <strong><i class="bi bi-check-circle"></i> Achieved</strong> on {{ ticket.achievedAt|date('d/m/Y') }}
                            {% if ticket.completedBy %} by {{ ticket.completedBy.firstname }} {{ ticket.completedBy.lastname }}{% endif %}.
                            {% if ticket.completionImage %}
                                <div class="mt-2"><img src="{{ asset('images/ticket_completions/' ~ ticket.completionImage) }}" alt="Proof" class="img-fluid rounded" style="max-height: 180px;"></div>
                            {% endif %}
                        </div>
                    {% elseif ticket.completionSubmittedAt %}
                        <div class="alert alert-info mt-3 mb-0">Completion submitted; waiting for administrator approval.</div>
                    {% elseif app.user and (is_granted('ROLE_USER') or is_granted('ROLE_NGO')) %}
                        <div class="mt-3">
                            <a href="{{ path('public_ticket_complete', { id: ticket.id }) }}" class="btn btn-success">I completed this</a>
                            <span class="text-muted small ms-2">Submit proof that you completed this task.</span>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
