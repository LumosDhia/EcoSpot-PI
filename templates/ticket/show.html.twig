{% extends public_view|default(false) ? 'base_front.html.twig' : 'base_back.html.twig' %}

{% block title %}{{ ticket.title }} - EcoSpot{% endblock %}
{% block page_title %}{% if not public_view|default(false) %}{{ ticket.title }}{% endif %}{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="badge bg-{{ ticket.status.getBadgeClass() }} p-2">{{ ticket.status.getLabel()|translate }}</span>
                <span class="priority-badge priority-{{ ticket.priority.value|lower }}">
                    <i class="fas fa-{{ ticket.priority.value == 'LOW' ? 'leaf' : (ticket.priority.value == 'MEDIUM' ? 'info-circle' : (ticket.priority.value == 'HIGH' ? 'exclamation-circle' : 'bolt')) }} me-1"></i>
                    {{ ticket.priority.getLabel()|translate }}
                </span>
                {% if not public_view|default(false) %}
                    <a href="{{ path('ticket_my_list') }}" class="btn btn-sm btn-outline-secondary">← {{ 'tickets.my_tickets_back'|trans }}</a>
                {% else %}
                    <a href="{{ path('public_tickets') }}" class="btn btn-sm btn-outline-secondary">← {{ 'tickets.all_tickets'|trans }}</a>
                {% endif %}
            </div>
            <div class="card-body">
                {% if ticket.image %}
                    <div class="mb-3">
                        <img src="{{ asset(ticket.image) }}" alt="{{ ticket.title|translate }}" class="img-fluid rounded" style="max-height: 280px; object-fit: cover;">
                    </div>
                {% endif %}
                <h1 class="h4 card-title">{{ ticket.title|translate }}</h1>
                <p class="text-muted small mb-2">
                    <i class="bi {{ ticket.domain.getIcon() }}"></i> {{ ticket.domain.getLabel()|translate }}
                    &middot; <i class="bi bi-geo-alt"></i> {{ ticket.location|translate }}
                </p>
                <div class="card-text">{{ ticket.description|translate|nl2br }}</div>

                {% if ticket.consignes|length > 0 %}
                    <div class="mt-4 mb-3">
                        <h6 class="text-success fw-bold"><i class="bi bi-list-check"></i> {{ 'tickets.tasks_to_complete'|trans|default('Tasks to complete') }}</h6>
                        <ul class="list-group list-group-flush border rounded-3 overflow-hidden shadow-sm">
                            {% for consigne in ticket.consignes %}
                                <li class="list-group-item d-flex align-items-center gap-3 py-3 border-bottom">
                                    <div class="rounded-circle border d-flex align-items-center justify-content-center flex-shrink-0" 
                                         style="width: 24px; height: 24px; color: var(--eco-leaf);">
                                        {{ loop.index }}
                                    </div>
                                    <div class="flex-grow-1 text-muted">
                                        {{ consigne.description|translate }}
                                    </div>
                                    {% if consigne.isCompleted %}
                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    {% else %}
                                        <i class="bi bi-circle text-muted opacity-25 fs-5"></i>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
                {% if ticket.adminNotes and ticket.status.value == 'SENT_BACK' %}
                    <div class="alert alert-light border mt-3 mb-0">
                        <strong>{{ 'tickets.admin_note'|trans }}:</strong> {{ ticket.adminNotes|translate }}
                    </div>
                {% endif %}
                <p class="small text-muted mt-3 mb-0">{{ 'common.created'|trans }} {{ ticket.createdAt|date('d/m/Y H:i') }}</p>
                {% if forecast|default([])|length > 0 %}
                    <div class="mt-3 mb-3">
                        <h6 class="text-primary"><i class="bi bi-cloud-sun"></i> {{ 'tickets.weather_forecast'|trans({'%location%': ticket.location|translate}) }}</h6>
                        <div class="d-flex flex-wrap gap-2">
                            {% for day in forecast %}
                                <div class="border rounded px-2 py-1 small" style="min-width: 5rem;">
                                    <div class="fw-bold">{{ day.date|date('d/m') }}</div>
                                    <div>{{ day.temp_min|round(0) }}° – {{ day.temp_max|round(0) }}°C</div>
                                    <div class="text-muted">{{ day.description|translate }}</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if ticket.status.value == 'PUBLISHED' %}
                    {% if ticket.achievedAt %}
                        <div class="alert alert-success mt-3 mb-0">
                            <strong><i class="bi bi-check-circle"></i> {{ 'tickets.achieved'|trans }}</strong> {{ 'common.on'|trans }} {{ ticket.achievedAt|date('d/m/Y') }}
                            {% if ticket.completedBy %} {{ 'tickets.achieved_by'|trans }} {{ ticket.completedBy.firstname }} {{ ticket.completedBy.lastname }}{% endif %}.
                            {% if ticket.completionImage %}
                                <div class="mt-2"><img src="{{ asset('images/ticket_completions/' ~ ticket.completionImage) }}" alt="Proof" class="img-fluid rounded" style="max-height: 180px;"></div>
                            {% endif %}
                        </div>
                    {% elseif ticket.completionSubmittedAt %}
                        <div class="alert alert-info mt-3 mb-0">{{ 'tickets.wait_approval'|trans }}</div>
                    {% elseif app.user and (is_granted('ROLE_USER') or is_granted('ROLE_NGO')) %}
                        <div class="mt-3">
                            <a href="{{ path('public_ticket_complete', { id: ticket.id }) }}" class="btn btn-success">{{ 'tickets.i_completed'|trans }}</a>
                            <span class="text-muted small ms-2">{{ 'tickets.submit_proof'|trans }}</span>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
