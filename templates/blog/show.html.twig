{% extends 'base_front.html.twig' %}

{% block title %}{{ article.title|translate }} - EcoSpot Blog{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .article-content.prose { font-size: 1.0625rem; line-height: 1.7; }
        .article-content.prose img { max-width: 100%; height: auto; border-radius: 0.25rem; }
        .article-content.prose ul, .article-content.prose ol { padding-left: 1.5rem; margin-bottom: 1rem; }
        .article-content.prose p { margin-bottom: 1rem; }
        .article-content.prose h2 { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 1.25rem; }
        .article-content.prose table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
        .article-content.prose table td, .article-content.prose table th { border: 1px solid #dee2e6; padding: 0.5rem; }
    </style>
{% endblock %}

{% block breadcrumb %}
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h3 class="text-white display-3 mb-4">{{ article.title|translate }}</h3>
            <p class="fs-5 text-white mb-4">{{ 'blog.published_on'|trans }} {{ (article.publishedAt ?? article.createdAt)|date('d/m/Y H:i') }}</p>
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('blog_index') }}">Blog</a></li>
                <li class="breadcrumb-item active text-white">Article</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container-fluid py-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <article class="blog-item mb-5">
                        {% if article.image %}
                            <div class="blog-img mb-4">
                                <img src="{{ article.image starts with 'http' ? article.image : asset(article.image) }}" class="img-fluid w-100 rounded" alt="{{ article.title|translate }}">
                            </div>
                        {% endif %}
                        <div class="text-dark border p-4 p-md-5">
                            {% if article.category %}
                                <a href="{{ path('blog_index', { 'category': article.category.id }) }}" class="badge bg-primary mb-2 text-decoration-none">
                                    {{ article.category.name }}
                                </a>
                            {% endif %}
                            <h1 class="mb-4">{{ article.title|translate }}</h1>
                            {% if article.tags|length > 0 %}
                                <div class="mb-3">
                                    {% for tag in article.tags %}
                                        <a href="{{ path('blog_index', { 'tag': tag.id }) }}" class="badge border border-primary text-primary small me-1 text-decoration-none">
                                            #{{ tag.name }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <p class="text-muted small mb-4">
                                <i class="fa fa-clock me-2"></i>{{ article.publishedAt ? article.publishedAt|date('d/m/Y H:i') : article.createdAt|date('d/m/Y H:i') }}
                                <span class="ms-3"><i class="fa fa-book-reader me-1"></i>{{ article.readingTime }} min read</span>
                                <span class="ms-3"><i class="fa fa-eye me-1"></i>{{ article.views }} views</span>
                                <span class="ms-3" id="article-likes-count"><i class="fa fa-thumbs-up me-1"></i>{{ article.likesCount }}</span>
                                <span class="ms-3" id="article-dislikes-count"><i class="fa fa-thumbs-down me-1"></i>{{ article.dislikesCount }}</span>
                                {% if article.writer %}
                                    <span class="ms-3"><i class="fas fa-user-edit me-1"></i>{{ 'common.writer'|trans }}: {{ article.writer.firstname }} {{ article.writer.lastname }}</span>
                                {% endif %}
                            </p>
                            <div class="article-content prose mb-4">{{ article.content|translate|raw }}</div>

                            {# Reactions section #}
                            <div class="border-top pt-4 mt-4 d-flex align-items-center gap-3">
                                <span class="fw-bold me-2">Rate this article:</span>
                                {% set userReaction = app.user ? article.userReaction(app.user) : null %}
                                <button class="btn {{ userReaction and userReaction.type == 'like' ? 'btn-primary' : 'btn-outline-primary' }} reaction-btn" 
                                        data-type="like" data-url="{{ path('blog_react', {slug: article.slug, type: 'like'}) }}">
                                    <i class="fa fa-thumbs-up me-1"></i> Like
                                </button>
                                <button class="btn {{ userReaction and userReaction.type == 'dislike' ? 'btn-danger' : 'btn-outline-danger' }} reaction-btn" 
                                        data-type="dislike" data-url="{{ path('blog_react', {slug: article.slug, type: 'dislike'}) }}">
                                    <i class="fa fa-thumbs-down me-1"></i> Dislike
                                </button>
                            </div>
                        </div>
                    </article>

                    <section class="border p-4 p-md-5 mb-5">
                        <h4 class="mb-4">{{ 'blog.comments'|trans }} ({{ comments|length }})</h4>
                        {% for comment in comments %}
                            <div class="border-bottom pb-3 mb-3 {% if not loop.last %}{% else %}border-0 mb-0{% endif %}">
                                <strong class="text-primary">{{ comment.author }}</strong>
                                <span class="text-muted small"> — {{ comment.createdAt|date('d/m/Y H:i') }}</span>
                                <p class="mb-0 mt-1">{{ comment.content|nl2br }}</p>
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">{{ 'blog.no_comments'|trans }}</p>
                        {% endfor %}
                    </section>

                    <section class="border p-4 p-md-5">
                        <h4 class="mb-4">{{ 'blog.leave_comment'|trans }}</h4>
                        {% if app.user %}
                            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                            <div class="mb-3">
                                {{ form_row(form.content) }}
                            </div>
                            <button type="submit" class="btn-hover-bg btn btn-primary text-white py-2 px-4">{{ 'blog.submit_comment'|trans }}</button>
                            {{ form_end(form) }}
                            <p class="text-muted small mt-2 mb-0">Comment will appear as {{ app.user.firstname }} {{ app.user.lastname }}.</p>
                        {% else %}
                            <p class="text-muted mb-0">{{ 'blog.sign_in_to_comment'|trans({'%url%': path('app_login', { _target_path: app.request.requestUri })})|raw }}</p>
                        {% endif %}
                    </section>

                    <p class="mt-4">
                        <a href="{{ path('blog_index') }}" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-2"></i>{{ 'blog.back_to_blog'|trans }}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const reactionBtns = document.querySelectorAll('.reaction-btn');
        reactionBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const url = this.getAttribute('data-url');
                const type = this.getAttribute('data-type');
                
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.status === 401) {
                        window.location.href = "{{ path('app_login', { _target_path: app.request.requestUri }) }}";
                        return;
                    }
                    return response.json();
                })
                .then(data => {
                    if (data) {
                        document.getElementById('article-likes-count').innerHTML = '<i class="fa fa-thumbs-up me-1"></i>' + data.likes;
                        document.getElementById('article-dislikes-count').innerHTML = '<i class="fa fa-thumbs-down me-1"></i>' + data.dislikes;
                        
                        reactionBtns.forEach(b => {
                            const bType = b.getAttribute('data-type');
                            if (bType === 'like') {
                                b.className = 'btn ' + (data.userReaction === 'like' ? 'btn-primary' : 'btn-outline-primary') + ' reaction-btn';
                            } else {
                                b.className = 'btn ' + (data.userReaction === 'dislike' ? 'btn-danger' : 'btn-outline-danger') + ' reaction-btn';
                            }
                        });
                    }
                });
            });
        });
    });
    </script>
{% endblock %}
