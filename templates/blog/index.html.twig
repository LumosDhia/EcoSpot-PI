{% extends 'base_front.html.twig' %}

{% block title %}Blog - EcoSpot{% endblock %}

{% block breadcrumb %}
    <!-- Header (Environs breadcrumb) -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h3 class="text-white display-3 mb-4">{{ 'blog.latest_news'|trans }}</h3>
            <p class="fs-5 text-white mb-4">{{ 'blog.articles'|trans }}</p>
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a></li>
                <li class="breadcrumb-item active text-white">{{ 'nav.blog'|trans }}</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .article-excerpt { font-size: 1rem; line-height: 1.5; }
    </style>
{% endblock %}

{% block body %}
    <!-- Blog (Environs) -->
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="text-center mx-auto pb-5" style="max-width: 800px;">
                <h5 class="text-uppercase text-primary">{{ 'blog.latest_news'|trans }}</h5>
                <h1 class="mb-4">{{ 'home.blog_desc'|trans }}</h1>
            </div>

            {# Search & Sort #}
            <div class="card mb-5">
                <div class="card-body">
                    <form method="get" action="{{ path('blog_index') }}" class="row g-3 align-items-end" novalidate="novalidate">
                        <div class="col-md-7">
                            <label for="search" class="form-label small text-muted mb-1">{{ 'blog.search_label'|trans }}</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                                <input type="text" name="search" id="search" class="form-control border-start-0 ps-0" placeholder="{{ 'blog.search_placeholder'|trans }}" value="{{ app.request.query.get('search') }}">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="order" class="form-label small text-muted mb-1">{{ 'blog.sort_label'|trans }}</label>
                            <select name="order" id="order" class="form-select" onchange="this.form.submit()">
                                <option value="desc" {{ app.request.query.get('order') == 'desc' ? 'selected' : '' }}>{{ 'blog.newest'|trans }}</option>
                                <option value="asc" {{ app.request.query.get('order') == 'asc' ? 'selected' : '' }}>{{ 'blog.oldest'|trans }}</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            {# Active Filters #}
            {% if selectedCategory or selectedTag or selectedWriter or search %}
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-0">
                            <div>
                                <i class="fas fa-filter me-2"></i>
                                {{ 'blog.showing_articles'|trans }} 
                                {% if selectedCategory %} {{ 'blog.filter_in'|trans }} <strong>{{ selectedCategory.name|translate }}</strong>{% endif %}
                                {% if selectedTag %} {{ 'blog.filter_with_tag'|trans }} <strong>#{{ selectedTag.name|translate }}</strong>{% endif %}
                                {% if selectedWriter %} {{ 'blog.filter_by'|trans }} <strong>{{ selectedWriter.firstname }} {{ selectedWriter.lastname }}</strong>{% endif %}
                                {% if search %} {{ 'blog.filter_matching'|trans }} <strong>"{{ search }}"</strong>{% endif %}
                            </div>
                            <a href="{{ path('blog_index') }}" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-times me-1"></i> {{ 'blog.clear_all'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="row g-4">
                {% for article in pagination %}
                    <div class="col-lg-6 col-xl-3">
                        <div class="blog-item">
                            <div class="blog-img">
                                {% if article.image %}
                                    <img src="{{ article.image starts with 'http' ? article.image : asset(article.image) }}" class="img-fluid w-100" alt="{{ article.title|translate }}">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=800" class="img-fluid w-100" alt="{{ article.title|translate }}" loading="lazy">
                                {% endif %}
                                <div class="blog-info">
                                    <span><i class="fa fa-clock"></i> {{ (article.publishedAt ?? article.createdAt)|date('d M Y') }}</span>
                                    <div class="d-flex">
                                        <span class="me-3">{{ article.comments|length }} <i class="fa fa-comment"></i></span>
                                        <span class="me-3"><i class="fa fa-book-reader"></i> {{ article.readingTime }} min read</span>
                                        <span class="me-3"><i class="fa fa-eye"></i> {{ article.views }}</span>
                                        <span class="me-3"><i class="fa fa-thumbs-up"></i> {{ article.likesCount }}</span>
                                        <span><i class="fa fa-thumbs-down"></i> {{ article.dislikesCount }}</span>
                                    </div>
                                </div>
                                <div class="search-icon">
                                    <a href="{{ path('blog_show', { slug: article.slug }) }}" class="btn btn-primary px-3">{{ 'common.read_more'|trans }}</a>
                                </div>
                            </div>
                            <div class="text-dark border p-4">
                                {% if article.category %}
                                    <a href="{{ path('blog_index', { 'category': article.category.id }) }}" class="badge bg-primary mb-2 text-decoration-none">
                                        {{ article.category.name|translate }}
                                    </a>
                                {% endif %}
                                <h4 class="mb-4">{{ article.title|translate }}</h4>
                                {% if article.writer %}
                                    <p class="text-muted small mb-2">
                                        {{ 'common.writer'|trans }}: 
                                        <a href="{{ path('blog_index', { 'writer': article.writer.id }) }}" class="text-decoration-none text-primary">
                                            {{ article.writer.firstname }} {{ article.writer.lastname }}
                                        </a>
                                    </p>
                                {% endif %}
                                {% set excerptText = article.content|translate|striptags|decode_html_entities %}
                                <p class="mb-4 article-excerpt">{{ excerptText|length > 120 ? excerptText|slice(0, 120) ~ '...' : excerptText }}</p>
                                <a class="btn-hover-bg btn btn-primary text-white py-2 px-4" href="{{ path('blog_show', { slug: article.slug }) }}">{{ 'common.read_more'|trans }}</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="col-12 text-center py-5">
                            <p class="text-muted">{{ 'blog.no_articles'|trans }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-5 d-flex justify-content-center">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>
{% endblock %}
