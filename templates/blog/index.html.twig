{% extends 'base_front.html.twig' %}

{% block title %}Blog - EcoSpot{% endblock %}

{% block breadcrumb %}
    <!-- Header (Environs breadcrumb) -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h1 class="text-white display-3 mb-4">{{ 'blog.latest_news'|trans }}</h1>
            <p class="fs-5 text-white mb-4">{{ 'blog.articles'|trans }}</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb justify-content-center mb-0">
                    <li class="breadcrumb-item"><a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a></li>
                    <li class="breadcrumb-item active text-white" aria-current="page">{{ 'nav.blog'|trans }}</li>
                </ol>
            </nav>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .article-excerpt { font-size: 1rem; line-height: 1.5; }
    </style>
{% endblock %}

{% block body %}
    <!-- Blog (Environs) -->
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="text-center mx-auto pb-5" style="max-width: 800px;">
                <h5 class="text-uppercase text-primary">{{ 'blog.latest_news'|trans }}</h5>
                <h1 class="mb-4">{{ 'home.blog_desc'|trans }}</h1>
            </div>

            {# Search & Sort #}
            <div class="card mb-5">
                <div class="card-body">
                    <form method="get" action="{{ path('blog_index') }}" class="row g-3 align-items-end" novalidate="novalidate">
                        <div class="col-md-7">
                            <label for="search" class="form-label small text-muted mb-1">{{ 'blog.search_label'|trans }}</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted" aria-hidden="true"></i></span>
                                <input type="text" name="search" id="search" class="form-control border-start-0 ps-0" placeholder="{{ 'blog.search_placeholder'|trans }}" value="{{ app.request.query.get('search') }}" aria-label="{{ 'blog.search_placeholder'|trans }}">
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="order" class="form-label small text-muted mb-1">{{ 'blog.sort_label'|trans }}</label>
                            <select name="order" id="order" class="form-select" onchange="this.form.submit()">
                                <option value="desc" {{ app.request.query.get('order') == 'desc' ? 'selected' : '' }}>{{ 'blog.newest'|trans }}</option>
                                <option value="asc" {{ app.request.query.get('order') == 'asc' ? 'selected' : '' }}>{{ 'blog.oldest'|trans }}</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            {# Active Filters #}
            {% if selectedCategory or selectedTag or selectedWriter or search %}
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-0">
                            <div>
                                <i class="fas fa-filter me-2"></i>
                                {{ 'blog.showing_articles'|trans }} 
                                {% if selectedCategory %} {{ 'blog.filter_in'|trans }} <strong>{{ selectedCategory.name|translate }}</strong>{% endif %}
                                {% if selectedTag %} {{ 'blog.filter_with_tag'|trans }} <strong>#{{ selectedTag.name|translate }}</strong>{% endif %}
                                {% if selectedWriter %} {{ 'blog.filter_by'|trans }} <strong>{{ selectedWriter.firstname }} {{ selectedWriter.lastname }}</strong>{% endif %}
                                {% if search %} {{ 'blog.filter_matching'|trans }} <strong>"{{ search }}"</strong>{% endif %}
                            </div>
                            <a href="{{ path('blog_index') }}" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-times me-1"></i> {{ 'blog.clear_all'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="row g-4">
                {% for article in pagination %}
                    <div class="col-lg-6 col-xl-3">
                        <div class="blog-item">
                            <div class="blog-img">
                                {% if article.image %}
                                    <img src="{{ article.image starts with 'http' ? article.image : asset(article.image) }}" class="img-fluid w-100" alt="{{ article.title|translate }}" style="height: 220px; object-fit: cover;">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=800" class="img-fluid w-100" alt="{{ article.title|translate }}" loading="lazy" style="height: 220px; object-fit: cover;">
                                {% endif %}
                                <div class="search-icon">
                                    <a href="{{ path('blog_show', { slug: article.slug }) }}" class="btn btn-primary px-3" aria-label="{{ 'common.read_more'|trans }} about {{ article.title|translate }}">{{ 'common.read_more'|trans }}</a>
                                </div>
                            </div>
                            <div class="text-dark border border-top-0 p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    {% if article.category %}
                                        <a href="{{ path('blog_index', { 'category': article.category.id }) }}" class="badge bg-primary text-decoration-none">
                                            {{ article.category.name|translate }}
                                        </a>
                                    {% else %}
                                        <span></span>
                                    {% endif %}
                                    <small class="text-muted">
                                        <i class="fa fa-calendar-alt me-1"></i>
                                        {% set articleDate = article.publishedAt ?? article.createdAt %}
                                        {{ articleDate|ago }}
                                    </small>
                                </div>

                                <h2 class="h5 mb-3" style="min-height: 3rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5; margin-top: 10px;">
                                    <a href="{{ path('blog_show', { slug: article.slug }) }}" class="text-dark text-decoration-none hover-primary">{{ article.title|translate }}</a>
                                </h2>

                                <div class="d-flex flex-wrap gap-2 text-muted small mb-3 py-2 border-top border-bottom bg-light px-2 rounded-2">
                                    <span title="{{ 'blog.views'|trans }}"><i class="fa fa-eye me-1 text-primary"></i>{{ article.views }}</span>
                                    <span title="{{ 'blog.likes'|trans }}"><i class="fa fa-thumbs-up me-1 text-success"></i>{{ article.likesCount }}</span>
                                    <span title="{{ 'blog.dislikes'|trans }}"><i class="fa fa-thumbs-down me-1 text-danger"></i>{{ article.dislikesCount }}</span>
                                    <span title="{{ 'blog.reading_time'|trans }}"><i class="fa fa-book-reader me-1 text-info"></i>{{ article.readingTime }}m</span>
                                    <span title="{{ 'blog.comments'|trans }}"><i class="fa fa-comment me-1 text-secondary"></i>{{ article.comments|length }}</span>
                                </div>

                                {% if article.writer %}
                                    <p class="text-muted extra-small mb-2">
                                        <i class="fas fa-user-edit me-1"></i>
                                        <a href="{{ path('blog_index', { 'writer': article.writer.id }) }}" class="text-decoration-none text-muted" aria-label="{{ 'blog.filter_by'|trans }} {{ article.writer.firstname }} {{ article.writer.lastname }}">
                                            {{ article.writer.firstname }} {{ article.writer.lastname }}
                                        </a>
                                    </p>
                                {% endif %}

                                {% set excerptText = article.content|translate|striptags|decode_html_entities %}
                                <p class="mb-4 article-excerpt text-muted small" style="height: 4.5rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    {{ excerptText }}
                                </p>
                                <a class="btn-hover-bg btn btn-primary text-white w-100 py-2" href="{{ path('blog_show', { slug: article.slug }) }}" aria-label="{{ 'common.read_more'|trans }} about {{ article.title|translate }}">{{ 'common.read_more'|trans }}</a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="col-12 text-center py-5">
                            <p class="text-muted">{{ 'blog.no_articles'|trans }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="mt-5 d-flex justify-content-center">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>

    <script>
        // Ensure the page refreshes when navigating back, so view counts and likes are up to date
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation.type === 2)) {
                window.location.reload();
            }
        });
    </script>
{% endblock %}
