{% extends 'base_back.html.twig' %}

{% block title %}Dashboard - EcoSpot{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .eco-dashboard-card {
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            background: #ffffff;
            border: 1px solid rgba(45, 106, 79, 0.1);
            position: relative;
            z-index: 1;
        }

        .eco-dashboard-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(82, 183, 136, 0.05) 0%, rgba(45, 106, 79, 0) 100%);
            z-index: -1;
            transition: opacity 0.3s ease;
            opacity: 0;
        }

        .eco-dashboard-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(27, 67, 50, 0.1);
            border-color: rgba(82, 183, 136, 0.4);
        }

        .eco-dashboard-card:hover::before {
            opacity: 1;
        }

        .eco-dashboard-icon-wrap {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(82, 183, 136, 0.1) 0%, rgba(45, 106, 79, 0.1) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            transition: all 0.4s ease;
        }

        .eco-dashboard-icon-wrap i {
            color: var(--eco-forest);
            transition: all 0.3s ease;
        }

        .eco-dashboard-card:hover .eco-dashboard-icon-wrap {
            transform: scale(1.1) rotate(5deg);
            background: linear-gradient(135deg, var(--eco-forest) 0%, var(--eco-dark-green) 100%);
            box-shadow: 0 8px 20px rgba(45, 106, 79, 0.3);
        }

        .eco-dashboard-card:hover .eco-dashboard-icon-wrap i {
            color: #ffffff !important;
        }

        .eco-dashboard-title {
            font-weight: 700;
            color: var(--eco-dark-green);
            margin-bottom: 0.5rem;
        }

        .eco-dashboard-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            font-size: 0.8rem;
            padding: 0.35em 0.65em;
            border-radius: 20px;
            font-weight: 600;
            background: var(--eco-forest) !important;
            box-shadow: 0 4px 10px rgba(45, 106, 79, 0.3);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="row g-4 mt-1">
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('ticket_my_list') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm eco-dashboard-card">
                    <div class="card-body text-center py-5 position-relative">
                        {% if my_tickets_count is defined and my_tickets_count > 0 %}
                            <span class="badge eco-dashboard-badge">{{ my_tickets_count }}</span>
                        {% endif %}
                        <div class="eco-dashboard-icon-wrap">
                            <i class="fas fa-ticket-alt fa-2x"></i>
                        </div>
                        <h5 class="eco-dashboard-title">My tickets</h5>
                        <p class="card-text small text-muted">View and manage your submitted environmental tickets</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('ticket_create') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm eco-dashboard-card">
                    <div class="card-body text-center py-5">
                        <div class="eco-dashboard-icon-wrap">
                            <i class="fas fa-plus-circle fa-2x"></i>
                        </div>
                        <h5 class="eco-dashboard-title">Create a ticket</h5>
                        <p class="card-text small text-muted">Report an environmental issue or suggestion quickly</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('public_tickets') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm eco-dashboard-card">
                    <div class="card-body text-center py-5">
                         <div class="eco-dashboard-icon-wrap">
                            <i class="fas fa-list fa-2x"></i>
                        </div>
                        <h5 class="eco-dashboard-title">Community tickets</h5>
                        <p class="card-text small text-muted">Browse and complete eco-tickets from the community</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('public_achievements') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm eco-dashboard-card">
                    <div class="card-body text-center py-5">
                         <div class="eco-dashboard-icon-wrap">
                            <i class="fas fa-trophy fa-2x"></i>
                        </div>
                        <h5 class="eco-dashboard-title">Achievements</h5>
                        <p class="card-text small text-muted">See completed tickets and celebrate community impact</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
