{% extends 'base_back.html.twig' %}

{% block title %}Dashboard - EcoSpot{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('ticket_my_list') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">My tickets</h5>
                        <p class="card-text small text-muted">View and manage your submitted tickets</p>
                        {% if my_tickets_count is defined and my_tickets_count > 0 %}<span class="badge bg-primary">{{ my_tickets_count }}</span>{% endif %}
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('ticket_create') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-plus-circle fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Create a ticket</h5>
                        <p class="card-text small text-muted">Report an environmental issue or suggestion</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('public_tickets') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-list fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Community tickets</h5>
                        <p class="card-text small text-muted">Browse and complete tickets from the community</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a href="{{ path('public_achievements') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-trophy fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Achievements</h5>
                        <p class="card-text small text-muted">See completed tickets and who did them</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
