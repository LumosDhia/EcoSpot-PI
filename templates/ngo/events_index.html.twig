{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.my_events'|trans }} - EcoSpot{% endblock %}
{% block page_title %}{{ 'common.my_events'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>{{ 'common.events'|trans }}</span>
            <a href="{{ path('ngo_event_new') }}" class="btn btn-primary btn-sm">{{ 'admin.ngo.create_event'|trans }}</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.title'|trans }}</th>
                            <th>{{ 'events.location'|trans }}</th>
                            <th>{{ 'events.start'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td>{{ event.nom|translate }}</td>
                                <td>{{ event.lieu|translate }}</td>
                                <td>{{ event.dateDebut ? event.dateDebut|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center text-muted py-4">{{ 'admin.events.no_events'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
