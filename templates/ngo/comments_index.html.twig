{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.comments'|trans }} - EcoSpot{% endblock %}
{% block page_title %}{{ 'common.comments'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">{{ 'admin.ngo_comment_desc'|trans }}</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.author'|trans }}</th>
                            <th>{{ 'common.content'|trans }}</th>
                            <th>{{ 'common.article'|trans }}</th>
                            <th>{{ 'common.date'|trans }}</th>
                            <th>{{ 'common.flagged'|trans }}</th>
                            <th width="100">{{ 'common.action'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            <tr class="{{ comment.flagged ? 'table-warning' : '' }}">
                                <td>{{ comment.author }}</td>
                                <td>{{ comment.content|translate|slice(0, 50) }}{% if comment.content|length > 50 %}...{% endif %}</td>
                                <td>{{ comment.article.title|translate }}</td>
                                <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{% if comment.flagged %}<span class="badge bg-warning">{{ 'common.flagged'|trans }}</span>{% else %}—{% endif %}</td>
                                <td>
                                    {% if not comment.flagged %}
                                        <form method="post" action="{{ path('ngo_comment_flag', { id: comment.id }) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('flag' ~ comment.id) }}">
                                            <button type="submit" class="btn btn-warning btn-sm">{{ 'common.flag'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center text-muted py-4">{{ 'admin.no_comments_yet'|trans }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
