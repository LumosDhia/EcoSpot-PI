{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.edit'|trans }} - EcoSpot{% endblock %}
{% block page_title %}{{ 'common.edit'|trans }} {{ 'common.article'|trans }}{% endblock %}

{% block body %}
    {% if article.adminRevisionNote %}
        <div class="alert alert-warning mb-3">
            <strong>{{ 'admin.revision_requested'|trans }}:</strong><br>{{ article.adminRevisionNote|translate|nl2br }}
        </div>
    {% endif %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data' } }) }}
            <div class="mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.content) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
                {% if article.image %}
                    <small class="text-muted d-block">{{ 'form.current'|default('Current')|translate }}: {% if article.image starts with 'http' %}<a href="{{ article.image }}" target="_blank" rel="noopener">{{ 'common.view'|trans }}</a>{% else %}{{ article.image }}{% endif %}. {{ 'form.upload_new'|default('Upload new to replace')|translate }}.</small>
                {% else %}
                    <small class="text-muted">{{ 'form.image_file_help'|default('Upload a thumbnail or hero image (JPEG, PNG, GIF, WebP).')|translate }}</small>
                {% endif %}
            </div>
            <div class="mb-3">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
                <small class="text-muted">{{ 'form.image_url_help'|default('Or paste an image URL.')|translate }}</small>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.publishMode) }}
                    {{ form_widget(form.publishMode) }}
                    {{ form_errors(form.publishMode) }}
                </div>
                <div class="col-md-6 js-scheduled-wrap" style="display: none;">
                    {{ form_label(form.scheduledAt) }}
                    {{ form_widget(form.scheduledAt) }}
                    {{ form_errors(form.scheduledAt) }}
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                <a href="{{ path('ngo_articles_index') }}" class="btn btn-outline-secondary">{{ 'common.cancel'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>

    <script src="https://cdn.tiny.cloud/1/gjqfg77yk8o4mrwj66nk2auuw1ruj96uzsm32cxfp6quajrb/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var wrap = document.querySelector('.js-scheduled-wrap');
        var select = document.querySelector('#article_publishMode');
        function toggleScheduled() {
          wrap.style.display = select && select.value === 'schedule' ? 'block' : 'none';
        }
        if (select) {
          select.addEventListener('change', toggleScheduled);
          toggleScheduled();
        }

        tinymce.init({
          selector: '.article-content-editor',
          height: 400,
          plugins: 'lists link image code table',
          toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
          content_style: 'body { font-family: Roboto, sans-serif; font-size: 14px; }',
          images_upload_url: '{{ url('blog_editor_upload_image') }}',
          images_upload_credentials: true,
          automatic_uploads: true,
          images_reuse_filename: true,
        });

        document.querySelector('form')?.addEventListener('submit', function() {
          if (window.tinymce) window.tinymce.triggerSave();
        });
      });
    </script>
{% endblock %}
