{% extends 'base_back.html.twig' %}

{% block title %}Edit article - EcoSpot{% endblock %}
{% block page_title %}Edit article{% endblock %}

{% block body %}
    {% if article.adminRevisionNote %}
        <div class="alert alert-warning mb-3">
            <strong>Admin requested revisions:</strong><br>{{ article.adminRevisionNote|nl2br }}
        </div>
    {% endif %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data' } }) }}
            <div class="mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.content) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
                {% if article.image %}
                    <small class="text-muted d-block">Current: {% if article.image starts with 'http' %}<a href="{{ article.image }}" target="_blank" rel="noopener">image</a>{% else %}{{ article.image }}{% endif %}. Upload a new file to replace.</small>
                {% else %}
                    <small class="text-muted">Upload a thumbnail or hero image (JPEG, PNG, GIF, WebP).</small>
                {% endif %}
            </div>
            <div class="mb-3">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
                <small class="text-muted">Or paste an image URL.</small>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-4">
                        {{ form_label(form.category) }}
                        <div class="category-selection card p-3 bg-light shadow-sm">
                            <div class="form-check-list-scrollable" style="max-height: 200px; overflow-y: auto;">
                                {{ form_widget(form.category) }}
                            </div>
                            <hr>
                            {{ form_label(form.newCategory) }}
                            {{ form_widget(form.newCategory) }}
                            {{ form_errors(form.newCategory) }}
                        </div>
                        {{ form_errors(form.category) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-4">
                        {{ form_label(form.tags) }}
                        <div class="tags-selection card p-3 bg-light shadow-sm">
                            <div class="form-check-list-scrollable" style="max-height: 200px; overflow-y: auto;">
                                {{ form_widget(form.tags) }}
                            </div>
                            <hr>
                            {{ form_label(form.newTags) }}
                            {{ form_widget(form.newTags) }}
                            {{ form_errors(form.newTags) }}
                            <small class="text-muted d-block mt-1">{{ form.newTags.vars.help|trans }}</small>
                        </div>
                        {{ form_errors(form.tags) }}
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    {{ form_label(form.publishMode) }}
                    {{ form_widget(form.publishMode) }}
                    {{ form_errors(form.publishMode) }}
                </div>
                <div class="col-md-6 js-scheduled-wrap" style="display: none;">
                    {{ form_label(form.scheduledAt) }}
                    {{ form_widget(form.scheduledAt) }}
                    {{ form_errors(form.scheduledAt) }}
                </div>
            </div>

            <div class="card mb-4 border-primary">
                <div class="card-header d-flex justify-content-between align-items-center border-bottom bg-white py-3">
                    <h5 class="mb-0 fw-bold" style="color: var(--eco-forest);"><i class="fas fa-search me-2"></i> SEO Settings</h5>
                    <button type="button" id="js-generate-seo-btn" class="glass-button py-1 px-3">
                        <i class="fas fa-robot me-1"></i> {{ 'form.generate_seo_btn'|trans }}
                    </button>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        {{ form_label(form.seoTitle) }}
                        {{ form_widget(form.seoTitle) }}
                        {{ form_errors(form.seoTitle) }}
                        <small class="text-muted">{{ 'form.seo_title_help'|trans }}</small>
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.seoDescription) }}
                        {{ form_widget(form.seoDescription) }}
                        {{ form_errors(form.seoDescription) }}
                        <small class="text-muted">{{ 'form.seo_description_help'|trans }}</small>
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.seoKeywords) }}
                        {{ form_widget(form.seoKeywords) }}
                        {{ form_errors(form.seoKeywords) }}
                        <small class="text-muted">{{ 'form.seo_keywords_help'|trans }}</small>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="glass-button px-4 py-2">
                    <i class="fas fa-save me-2"></i> Save
                </button>
                <a href="{{ path('ngo_articles_index') }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>

    <script src="https://cdn.tiny.cloud/1/gjqfg77yk8o4mrwj66nk2auuw1ruj96uzsm32cxfp6quajrb/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var wrap = document.querySelector('.js-scheduled-wrap');
        var select = document.querySelector('#article_publishMode');
        function toggleScheduled() {
          wrap.style.display = select && select.value === 'schedule' ? 'block' : 'none';
        }
        if (select) {
          select.addEventListener('change', toggleScheduled);
          toggleScheduled();
        }

        tinymce.init({
          selector: '.article-content-editor',
          height: 400,
          plugins: 'lists link image code table',
          toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
          content_style: 'body { font-family: Roboto, sans-serif; font-size: 14px; }',
          images_upload_url: '{{ url('blog_editor_upload_image') }}',
          images_upload_credentials: true,
          automatic_uploads: true,
          images_reuse_filename: true,
        });

        document.querySelector('form')?.addEventListener('submit', function() {
          if (window.tinymce) window.tinymce.triggerSave();
        });

        // AI SEO Generation JS
        const generateSeoBtn = document.querySelector('#js-generate-seo-btn');
        const seoTitleField = document.querySelector('#article_seoTitle');
        const seoDescField = document.querySelector('#article_seoDescription');
        const seoKeysField = document.querySelector('#article_seoKeywords');
        const titleField = document.querySelector('#article_title');

        if (generateSeoBtn) {
            generateSeoBtn.addEventListener('click', function() {
                const title = titleField.value.trim();
                if (window.tinymce) window.tinymce.triggerSave();
                const content = document.querySelector('.article-content-editor').value.trim();

                if (!title || !content) {
                    alert('Please enter a title and some content first.');
                    return;
                }

                generateSeoBtn.disabled = true;
                const originalHtml = generateSeoBtn.innerHTML;
                generateSeoBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> {{ "form.generating_seo"|trans }}';

                fetch('{{ path("blog_api_seo_generate") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ title, content })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert('Error: ' + data.error);
                    } else {
                        if (data.title) seoTitleField.value = data.title;
                        if (data.description) seoDescField.value = data.description;
                        if (data.keywords) seoKeysField.value = data.keywords;
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Failed to generate SEO. Check console for details.');
                })
                .finally(() => {
                    generateSeoBtn.disabled = false;
                    generateSeoBtn.innerHTML = originalHtml;
                });
            });
        }
      });
    </script>
{% endblock %}
