{% extends 'base_back.html.twig' %}

{% block title %}Browse Tickets - EcoSpot{% endblock %}
{% block page_title %}Browse Environmental Tickets{% endblock %}

{% block stylesheets %}
    <style>
        .ticket-card {
            transition: transform 0.2s, box-shadow 0.2s;
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .ticket-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .ai-recommendation {
            background: linear-gradient(45deg, #FFD700, #FDB931);
            color: #4a4a4a;
            font-weight: bold;
            padding: 5px 15px;
            border-bottom-left-radius: 10px;
            position: absolute;
            top: 0;
            right: 0;
            z-index: 10;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    {% if recommendedTickets|length > 0 %}
        <h4 class="mb-4 text-warning"><i class="fas fa-magic me-2"></i> AI Recommended For You</h4>
        <div class="row g-4 mb-5">
            {% for ticket in recommendedTickets %}
                {% include 'ngo/_ticket_card.html.twig' with {'ticket': ticket, 'isRecommended': true, 'requestedTicketIds': requestedTicketIds} %}
            {% endfor %}
        </div>
    {% endif %}

    <h4 class="mb-4 text-dark"><i class="fas fa-list me-2"></i> All Published Tickets</h4>
    <div class="row g-4">
        {% for ticket in otherTickets %}
            {% include 'ngo/_ticket_card.html.twig' with {'ticket': ticket, 'isRecommended': false, 'requestedTicketIds': requestedTicketIds} %}
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">No other tickets available right now.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
