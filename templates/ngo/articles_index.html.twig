{% extends 'base_back.html.twig' %}

{% block title %}My Articles - EcoSpot{% endblock %}
{% block page_title %}My Articles{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Articles</span>
            <a href="{{ path('ngo_article_new') }}" class="btn btn-primary btn-sm">New article</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Published</th>
                            <th width="240">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for article in articles %}
                            <tr>
                                <td>{{ article.title }}</td>
                                <td>
                                    {% if article.publicationStatus == 'draft' %}
                                        <span class="badge bg-secondary">Draft</span>
                                    {% elseif article.publicationStatus == 'scheduled' %}
                                        <span class="badge bg-info">Scheduled</span>
                                    {% else %}
                                        <span class="badge bg-success">Published</span>
                                    {% endif %}
                                </td>
                                <td>{{ article.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    {% if article.publicationStatus == 'scheduled' and article.publishedAt %}
                                        <span class="text-info">Scheduled for {{ article.publishedAt|date('d/m/Y H:i') }}</span>
                                    {% elseif article.publishedAt %}
                                        {{ article.publishedAt|date('d/m/Y H:i') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('ngo_article_edit', { id: article.id }) }}" class="btn btn-outline-primary btn-sm">Edit</a>
                                    {% if article.publicationStatus == 'draft' %}
                                        <form method="post" action="{{ path('ngo_article_publish', { id: article.id }) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('publish' ~ article.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm">Publish</button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('ngo_article_delete', { id: article.id }) }}" class="d-inline" onsubmit="return confirm('Delete this article?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-center text-muted py-4">No articles yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
