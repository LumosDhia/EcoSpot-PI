{% extends 'base_back.html.twig' %}

{% block title %}My Assigned Ticket - EcoSpot{% endblock %}
{% block page_title %}My Assigned Ticket{% endblock %}

{% block stylesheets %}
<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    {% if ticket %}
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="glass-card p-4 p-md-5 mb-4 border-top border-5 border-{% if ticket.status.value == 'ASSIGNED' %}primary{% else %}info{% endif %}">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-bold mb-0 text-dark">{{ ticket.title }}</h2>
                        <span class="badge bg-{{ ticket.status.getBadgeClass() }} fs-6 rounded-pill px-3 py-2 shadow-sm">
                            <i class="{{ ticket.status.getIcon() }} me-1"></i> {{ ticket.status.getLabel()|trans }}
                        </span>
                    </div>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-8">
                            <h5 class="text-muted mb-3"><i class="fas fa-align-left me-2"></i> Description</h5>
                            <p class="lead" style="line-height: 1.8;">{{ ticket.description|nl2br }}</p>
                            
                            <hr class="my-4">
                            
                            <h5 class="text-muted mb-3"><i class="fas fa-tasks me-2"></i> Instructions ({{ ticket.consignes|length }})</h5>
                            {% if ticket.consignes|length > 0 %}
                                <ul class="list-group list-group-flush rounded shadow-sm">
                                    {% for consigne in ticket.consignes|sort((a, b) => a.position <=> b.position) %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                                            <span><strong>{{ loop.index }}.</strong> {{ consigne.description }}</span>
                                            <span class="badge bg-{{ consigne.difficulty.getBadgeClass() }}-subtle text-{{ consigne.difficulty.getBadgeClass() }} rounded-pill">
                                                {{ consigne.difficulty.getLabel()|trans }}
                                            </span>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <div class="alert alert-light text-center border-dashed">No specific instructions provided.</div>
                            {% endif %}
                        </div>
                        
                        <div class="col-md-4">
                            <div class="bg-light p-4 rounded-4 shadow-sm h-100">
                                <h6 class="text-uppercase text-muted fw-bold mb-3 small">Ticket Details</h6>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <div class="small text-muted">Location</div>
                                        <div class="fw-bold"><i class="fas fa-map-marker-alt text-danger"></i> {{ ticket.location }}</div>
                                    </li>
                                    <li class="mb-3">
                                        <div class="small text-muted">Domain</div>
                                        <div class="fw-bold">{{ ticket.domain.getLabel()|trans }}</div>
                                    </li>
                                    <li class="mb-3">
                                        <div class="small text-muted">Priority</div>
                                        <div class="fw-bold text-{{ ticket.priority.getBadgeClass() }}">{{ ticket.priority.getLabel()|trans }}</div>
                                    </li>
                                    <li class="mb-3">
                                        <div class="small text-muted">Reported By</div>
                                        <div class="fw-bold">{{ ticket.user.firstname }} {{ ticket.user.lastname }}</div>
                                    </li>
                                </ul>
                                
                                {% if ticket.image %}
                                    <div class="mt-4">
                                        <img src="{{ asset(ticket.image) }}" class="img-fluid rounded shadow-sm" alt="Ticket Image">
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-4 shadow-sm border mt-5">
                        <h4 class="mb-4 text-dark"><i class="fas fa-clipboard-list me-2"></i> Action Center</h4>
                        
                        {% if ticket.status.value == 'ASSIGNED' %}
                            <div class="alert alert-warning border-0 shadow-sm mb-4">
                                <strong><i class="fas fa-exclamation-circle me-1"></i> Action Required:</strong> You have been assigned this ticket. Please review the details and accept it to begin working.
                            </div>
                            <form action="{{ path('ngo_ticket_accept', {id: ticket.id}) }}" method="post" class="text-center">
                                <input type="hidden" name="_token" value="{{ csrf_token('accept_ticket_' ~ ticket.id) }}">
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow">
                                    <i class="fas fa-check-circle me-2"></i> Accept Ticket & Start Work
                                </button>
                            </form>

                        {% elseif ticket.status.value == 'IN_PROGRESS' %}
                            
                            <form action="{{ path('ngo_ticket_update', {id: ticket.id}) }}" method="post" class="mb-4">
                                <input type="hidden" name="_token" value="{{ csrf_token('update_ticket_' ~ ticket.id) }}">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Progress Notes</label>
                                    <textarea name="ngo_notes" class="form-control" rows="4" placeholder="Document your progress, what has been done, what is left..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                                    <i class="fas fa-save me-1"></i> Save Draft Notes
                                </button>
                            </form>
                            
                            <hr class="my-4 opacity-25">
                            
                            <div class="d-flex justify-content-between align-items-center bg-light p-4 rounded text-dark">
                                <div>
                                    <h5 class="mb-1 text-success fw-bold">Ready to complete?</h5>
                                    <p class="mb-0 small text-muted">Marking this as complete adds it to your achievements.</p>
                                </div>
                                <form action="{{ path('ngo_ticket_complete', {id: ticket.id}) }}" method="post" onsubmit="return confirm('Are you sure you have completed all tasks for this ticket?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('complete_ticket_' ~ ticket.id) }}">
                                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-4 shadow">
                                        <i class="fas fa-flag-checkered me-2"></i> Mark as Completed
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="text-center py-5">
            <div class="display-1 text-muted opacity-25 mb-4"><i class="fas fa-clipboard-check"></i></div>
            <h3 class="text-secondary fw-bold">All caught up!</h3>
            <p class="text-muted">You don't have an active assigned ticket.</p>
            <a href="{{ path('ngo_tickets_browse') }}" class="btn btn-primary rounded-pill mt-3 px-4 shadow-sm">
                <i class="fas fa-search me-2"></i> Browse Available Tickets
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
