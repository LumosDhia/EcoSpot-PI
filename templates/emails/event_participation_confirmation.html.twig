{% extends 'base_email.html.twig'|default('emails/layout.html.twig') %}

{% block body %}
<div style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #333;">
    <div style="background-color: #1b4332; padding: 40px; border-radius: 12px 12px 0 0; text-align: center;">
        <h1 style="color: #ffffff; margin: 0; font-size: 28px;">Booking Confirmed! 🌿</h1>
    </div>
    <div style="background-color: #ffffff; padding: 40px; border-radius: 0 0 12px 12px; border: 1px solid #e2e8f0; border-top: none;">
        <p style="font-size: 18px; margin-bottom: 24px;">Hello <strong>{{ user.firstname }}</strong>,</p>
        <p style="line-height: 1.6; margin-bottom: 30px;">
            You have successfully reserved your spot for <strong>{{ event.nom }}</strong>. We're thrilled to have you join our eco-mission!
        </p>
        
        <div style="background-color: #f0f7f4; padding: 25px; border-radius: 8px; margin-bottom: 30px;">
            <p style="margin: 0 0 10px 0;"><strong>📅 Date:</strong> {{ event.dateDebut|date('l, d F Y') }}</p>
            <p style="margin: 0 0 10px 0;"><strong>⏰ Time:</strong> {{ event.dateDebut|date('H:i') }}</p>
            <p style="margin: 0;"><strong>📍 Location:</strong> {{ event.lieu }}</p>
        </div>

        <div style="text-align: center;">
            <a href="{{ url('events_show', {slug: event.slug}) }}" style="background-color: #40916c; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: bold; display: inline-block;">View Event Details</a>
        </div>

        <hr style="margin: 40px 0; border: 0; border-top: 1px solid #e2e8f0;">
        <p style="font-size: 14px; color: #666; text-align: center;">
            Thank you for being part of the EcoSpot community. Together, we make a difference.
        </p>
    </div>
</div>
{% endblock %}
