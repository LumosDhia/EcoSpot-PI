<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background-color: #f0f0f0; padding: 20px; border-radius: 8px;">
        <h2 style="color: #e74c3c;">Event Deleted</h2>
        
        <p>
            <strong>{{ deletedBy.email }}</strong> has deleted an event:
        </p>

        <div style="background-color: white; padding: 15px; border-left: 4px solid #e74c3c; margin: 20px 0;">
            <h3 style="margin-top: 0; text-decoration: line-through;">{{ eventName }}</h3>
            <p style="color: #e74c3c;">This event has been permanently removed from the system.</p>
        </div>

        <p style="color: #666; font-size: 12px; margin-top: 30px;">
            This is an automated notification from EcoSpot. Please do not reply to this email.
        </p>
    </div>
</div>
