{% extends 'base_front.html.twig' %}

{% block title %}Register - EcoSpot{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h1 class="h4 mb-4 text-center">{{ 'security.register'|trans }}</h1>
                        {{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.firstname) }}
                        {{ form_row(registrationForm.lastname) }}
                        {{ form_row(registrationForm.address) }}
                        {{ form_row(registrationForm.zipcode) }}
                        {{ form_label(registrationForm.city) }}
                        <div class="input-group mb-2">
                            <input type="text" id="city_search_input" class="form-control" placeholder="Search for your city (e.g. Paris)">
                            <button class="btn btn-outline-secondary" type="button" id="city_search_button">Search</button>
                        </div>
                        <div id="city_suggestions" class="list-group mb-3 d-none" style="max-height: 200px; overflow-y: auto;"></div>
                        {{ form_widget(registrationForm.city) }}
                        {{ form_errors(registrationForm.city) }}
                        {{ form_row(registrationForm.plainPassword) }}
                        {{ form_row(registrationForm.agreeTerms) }}

                        {# ── Face Enrollment (optional) ──────────────────────────── #}
                        <div class="card border-0 bg-light rounded-3 p-3 mb-3">
                            <p class="fw-semibold mb-1">🤖 Face Recognition <span class="badge bg-secondary fw-normal">Optional</span></p>
                            <p class="text-muted small mb-2">Enroll your face now to enable one-click face login later.</p>

                            <div id="reg-models-status" class="text-muted small mb-2 d-none">
                                <span class="spinner-border spinner-border-sm me-1"></span> Loading AI models…
                            </div>

                            <div class="position-relative rounded overflow-hidden bg-dark mb-2 d-none" id="reg-cam-wrapper" style="height:180px;">
                                <video id="reg-video" autoplay muted playsinline class="w-100 h-100" style="object-fit:cover;"></video>
                                <canvas id="reg-canvas" class="position-absolute top-0 start-0 w-100 h-100"></canvas>
                            </div>

                            <div id="reg-face-status" class="alert d-none mb-2 py-2 small" role="alert"></div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" id="reg-btn-start" class="btn btn-sm btn-outline-primary">📷 Start Camera</button>
                                <button type="button" id="reg-btn-capture" class="btn btn-sm btn-success d-none">
                                    <span id="reg-spinner" class="spinner-border spinner-border-sm d-none me-1"></span>
                                    Capture &amp; Save Face
                                </button>
                                <button type="button" id="reg-btn-stop" class="btn btn-sm btn-outline-secondary d-none">✕ Stop</button>
                                <button type="button" id="reg-btn-clear" class="btn btn-sm btn-outline-danger d-none">🗑 Remove Face</button>
                            </div>

                            {# Hidden field — populated by JS with the JSON face descriptor #}
                            <input type="hidden" name="faceDescriptor" id="reg-face-descriptor">
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">{{ 'security.register'|trans }}</button>
                            <a class="btn btn-outline-secondary" href="{{ path('app_login') }}">{{ 'security.already_have_account'|trans }}</a>
                        </div>
                        {{ form_end(registrationForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('city_search_input');
            const searchButton = document.getElementById('city_search_button');
            const suggestionsContainer = document.getElementById('city_suggestions');
            const hiddenCityInput = document.getElementById('registration_form_city');

            searchButton.addEventListener('click', function() {
                const query = searchInput.value.trim();
                if (query.length < 2) {
                    suggestionsContainer.innerHTML = '<div class="list-group-item text-danger">Please enter at least 2 characters.</div>';
                    suggestionsContainer.classList.remove('d-none');
                    return;
                }

                suggestionsContainer.innerHTML = '<div class="list-group-item text-muted">Searching...</div>';
                suggestionsContainer.classList.remove('d-none');

                fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(query)}&count=10&language=en&format=json`)
                    .then(response => response.json())
                    .then(data => {
                        suggestionsContainer.innerHTML = '';
                        if (!data.results || data.results.length === 0) {
                            suggestionsContainer.innerHTML = '<div class="list-group-item text-muted">No cities found. Try another search.</div>';
                            return;
                        }

                        data.results.forEach(cityData => {
                            const option = document.createElement('button');
                            option.type = 'button';
                            option.className = 'list-group-item list-group-item-action';
                            
                            // Format: City Name, Region, Country
                            let displayName = cityData.name;
                            if (cityData.admin1) {
                                displayName += `, ${cityData.admin1}`;
                            }
                            if (cityData.country) {
                                displayName += `, ${cityData.country}`;
                            }

                            option.textContent = displayName;
                            
                            option.addEventListener('click', function() {
                                hiddenCityInput.value = cityData.name; // Use only the city name for the form value
                                searchInput.value = displayName; // Show full display name in search box
                                suggestionsContainer.classList.add('d-none');
                            });
                            
                            suggestionsContainer.appendChild(option);
                        });
                    })
                    .catch(error => {
                        console.error('Error fetching cities:', error);
                        suggestionsContainer.innerHTML = '<div class="list-group-item text-danger">Error communicating with search service. Please try again.</div>';
                    });
            });

            // Prevent form submission when pressing enter in the search input
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchButton.click();
                }
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script>
    (function () {
        'use strict';

        const MODELS_URL = '/models';
        let stream = null;
        let faceEnrolled = false;

        const $ = id => document.getElementById(id);
        const video      = $('reg-video');
        const canvas     = $('reg-canvas');
        const camWrapper = $('reg-cam-wrapper');
        const statusBox  = $('reg-face-status');
        const modStatus  = $('reg-models-status');
        const btnStart   = $('reg-btn-start');
        const btnCapture = $('reg-btn-capture');
        const btnStop    = $('reg-btn-stop');
        const btnClear   = $('reg-btn-clear');
        const spinner    = $('reg-spinner');
        const hidden     = $('reg-face-descriptor');

        function showStatus(msg, type = 'info') {
            statusBox.className = `alert alert-${type} mb-2 py-2 small`;
            statusBox.textContent = msg;
            statusBox.classList.remove('d-none');
        }

        // ── Load AI models on Start Camera click ──────────────────────────
        async function loadModels() {
            modStatus.classList.remove('d-none');
            btnStart.disabled = true;
            try {
                await Promise.all([
                    faceapi.nets.tinyFaceDetector.loadFromUri(MODELS_URL),
                    faceapi.nets.faceLandmark68Net.loadFromUri(MODELS_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(MODELS_URL),
                ]);
            } finally {
                modStatus.classList.add('d-none');
                btnStart.disabled = false;
            }
        }

        let modelsLoaded = false;

        async function startCamera() {
            if (!modelsLoaded) { await loadModels(); modelsLoaded = true; }
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                video.srcObject = stream;
                camWrapper.classList.remove('d-none');
                btnStart.classList.add('d-none');
                btnCapture.classList.remove('d-none');
                btnStop.classList.remove('d-none');
            } catch (e) {
                showStatus('Camera access denied or unavailable.', 'danger');
            }
        }

        function stopCamera() {
            if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
            video.srcObject = null;
            camWrapper.classList.add('d-none');
            btnCapture.classList.add('d-none');
            btnStop.classList.add('d-none');
            btnStart.classList.remove('d-none');
        }

        btnStart.addEventListener('click', startCamera);
        btnStop.addEventListener('click', stopCamera);

        btnCapture.addEventListener('click', async () => {
            btnCapture.disabled = true;
            spinner.classList.remove('d-none');
            showStatus('Detecting face with AI…', 'info');
            try {
                const options = new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.5 });
                const detection = await faceapi
                    .detectSingleFace(video, options)
                    .withFaceLandmarks()
                    .withFaceDescriptor();

                if (!detection) {
                    showStatus('No face detected — look at the camera and try again.', 'warning');
                    return;
                }

                // Visual confirmation
                const dims = faceapi.matchDimensions(canvas, video, true);
                faceapi.draw.drawDetections(canvas, faceapi.resizeResults(detection, dims));

                hidden.value = JSON.stringify(Array.from(detection.descriptor));
                faceEnrolled = true;
                showStatus('✅ Face captured! It will be saved when you register.', 'success');
                stopCamera();
                btnClear.classList.remove('d-none');
            } catch (e) {
                console.error(e);
                showStatus('Error during face detection. Please try again.', 'danger');
            } finally {
                btnCapture.disabled = false;
                spinner.classList.add('d-none');
            }
        });

        btnClear.addEventListener('click', () => {
            hidden.value = '';
            faceEnrolled = false;
            btnClear.classList.add('d-none');
            statusBox.classList.add('d-none');
            showStatus('Face data removed.', 'secondary');
        });
    })();
    </script>
{% endblock %}
