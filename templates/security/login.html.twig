{% extends 'base_front.html.twig' %}

{% block title %}Login - EcoSpot{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h1 class="h4 mb-4 text-center">{{ 'security.sign_in'|trans }}</h1>

                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3 text-center">
                                {{ 'security.logged_in_as'|trans({'%user%': app.user.userIdentifier}) }}, <a href="{{ path('app_logout') }}">{{ 'security.logout'|trans }}</a>
                            </div>
                        {% else %}
                            <form method="post">
                                <div class="mb-3">
                                    <label for="inputEmail" class="form-label">{{ 'security.email'|trans }}</label>
                                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                                </div>
                                <div class="mb-3">
                                    <label for="inputPassword" class="form-label">{{ 'security.password'|trans }}</label>
                                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                                </div>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <div class="d-grid gap-2">
                                    <button class="btn btn-primary" type="submit">{{ 'security.sign_in'|trans }}</button>
                                    <a class="btn btn-outline-secondary" href="{{ path('app_register') }}">{{ 'security.register'|trans }}</a>
                                </div>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
