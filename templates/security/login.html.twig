{% extends 'base_front.html.twig' %}

{% block title %}Login - EcoSpot{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h1 class="h4 mb-4 text-center">{{ 'security.sign_in'|trans }}</h1>

                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    {% if app.user %}
                        <div class="mb-3 text-center">
                            {{ 'security.logged_in_as'|trans({'%user%': app.user.userIdentifier}) }},
                            <a href="{{ path('app_logout') }}">{{ 'security.logout'|trans }}</a>
                        </div>
                    {% else %}

                        {# ── Tab navigation ─────────────────────────────────────── #}
                        <div class="d-flex justify-content-center mb-4 pt-2">
                            <div class="nav nav-pills shadow-sm p-1 bg-light rounded-pill" id="loginTabs" role="tablist" style="width: fit-content;">
                                <button class="nav-link active rounded-pill px-4" id="password-tab" data-bs-toggle="pill"
                                        data-bs-target="#password-pane" type="button" role="tab" style="font-weight: 600;">
                                    🔑 Password
                                </button>
                                <button class="nav-link rounded-pill px-4" id="face-tab" data-bs-toggle="pill"
                                        data-bs-target="#face-pane" type="button" role="tab" style="font-weight: 600;">
                                    🤖 Face Login
                                </button>
                            </div>
                        </div>

                        <div class="tab-content">

                            {# ── Tab 1: Password ────────────────────────────────── #}
                            <div class="tab-pane fade show active" id="password-pane" role="tabpanel">
                                <form method="post">
                                    <div class="mb-3">
                                        <label for="inputEmail" class="form-label">{{ 'security.email'|trans }}</label>
                                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
                                               class="form-control" autocomplete="email" required autofocus>
                                    </div>
                                    <div class="mb-3">
                                        <label for="inputPassword" class="form-label">{{ 'security.password'|trans }}</label>
                                        <input type="password" name="password" id="inputPassword"
                                               class="form-control" autocomplete="current-password" required>
                                    </div>
                                    <div class="mb-3 text-end">
                                        <a href="{{ path('app_forgot_password_request') }}">
                                            {{ 'security.forgot_password'|trans|default('Forgot password?') }}
                                        </a>
                                    </div>
                                    
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                    
                                    <div class="mb-3">
                                        <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button class="btn btn-primary" type="submit">{{ 'security.sign_in'|trans }}</button>
                                        <a class="btn btn-outline-secondary" href="{{ path('app_register') }}">{{ 'security.register'|trans }}</a>
                                    </div>
                                </form>
                            </div>

                            {# ── Tab 2: Face Recognition ────────────────────────── #}
                            <div class="tab-pane fade" id="face-pane" role="tabpanel">
                                <div id="face-login-ui" class="p-3 border rounded bg-white shadow-sm">
                                    <h5 class="mb-3 text-center">🤖 Face ID Sign In</h5>
                                    
                                    <div class="mb-3">
                                        <label for="face-email" class="form-label fw-bold">1. Enter your email</label>
                                        <input type="email" id="face-email" class="form-control form-control-lg"
                                               placeholder="example@email.com" autocomplete="email">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">2. Face Verification</label>
                                        {# Webcam preview #}
                                        <div id="camera-container" class="position-relative mb-2 rounded overflow-hidden bg-dark d-flex align-items-center justify-content-center" style="height:250px; border: 2px solid #dee2e6;">
                                            <video id="face-video" autoplay muted playsinline
                                                   class="w-100 h-100 d-none" style="object-fit:cover;"></video>
                                            <canvas id="face-snapshot" class="d-none" width="640" height="480"></canvas>
                                            
                                            <div id="face-placeholder" class="text-center p-4">
                                                <i class="fas fa-camera fa-3x text-muted mb-3"></i>
                                                <p class="text-white opacity-75 small">Camera is currently OFF</p>
                                                <button id="btn-start-camera-alt" class="btn btn-primary btn-sm mt-2">
                                                    Click to Start Camera
                                                </button>
                                            </div>

                                            <div id="camera-spinner" class="spinner-border text-light d-none" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                    </div>

                                    {# Status message #}
                                    <div id="face-status" class="alert d-none mb-3" role="alert"></div>

                                    <div class="d-grid gap-2">
                                        <button id="btn-scan-face" class="btn btn-success btn-lg d-none">
                                            <span id="face-scan-spinner" class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                                            Verify & Sign In
                                        </button>
                                        <button id="btn-stop-camera" class="btn btn-outline-danger btn-sm d-none">
                                            Stop Camera
                                        </button>
                                    </div>

                                    <div class="mt-3 text-center small text-muted">
                                        <i class="fas fa-shield-alt me-1"></i> Your face data is processed securely and never stored.
                                    </div>
                                </div>
                            </div>{# /face-pane #}

                        </div>{# /tab-content #}

                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
    (function () {
        'use strict';

        const VERIFY_URL = "{{ path('face_verify') }}";
        let stream = null;

        const $ = id => document.getElementById(id);
        const video = $('face-video');
        const canvas = $('face-snapshot');
        const statusBox = $('face-status');
        const btnStartAlt = $('btn-start-camera-alt');
        const btnScan = $('btn-scan-face');
        const btnStop = $('btn-stop-camera');
        const placeholder = $('face-placeholder');
        const spinner = $('face-scan-spinner');
        const camSpinner = $('camera-spinner');

        function showStatus(msg, type = 'info') {
            statusBox.className = `alert alert-${type} mb-3`;
            statusBox.textContent = msg;
            statusBox.classList.remove('d-none');
        }

        async function startCamera() {
            if (!window.isSecureContext) {
                showStatus("❌ Camera requires a secure context (HTTPS or localhost).", "danger");
                return;
            }

            camSpinner.classList.remove('d-none');
            placeholder.classList.add('d-none');
            if (btnStartAlt) btnStartAlt.disabled = true;

            try {
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } 
                });
                video.srcObject = stream;
                video.classList.remove('d-none');
                btnScan.classList.remove('d-none');
                btnStop.classList.remove('d-none');
                if (btnStartAlt) btnStartAlt.classList.add('d-none');
                statusBox.classList.add('d-none');
            } catch (e) {
                console.error(e);
                showStatus('Camera access denied or unavailable.', 'danger');
                placeholder.classList.remove('d-none');
            } finally {
                camSpinner.classList.add('d-none');
                if (btnStartAlt) btnStartAlt.disabled = false;
            }
        }

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(t => t.stop());
                stream = null;
            }
            video.srcObject = null;
            video.classList.add('d-none');
            placeholder.classList.remove('d-none');
            btnScan.classList.add('d-none');
            btnStop.classList.add('d-none');
            if (btnStartAlt) btnStartAlt.classList.remove('d-none');
        }

        if (btnStartAlt) btnStartAlt.addEventListener('click', startCamera);
        btnStop.addEventListener('click', () => { stopCamera(); statusBox.classList.add('d-none'); });

        btnScan.addEventListener('click', async () => {
            const email = $('face-email').value.trim();
            if (!email) { showStatus('Please enter your email first.', 'warning'); return; }
            if (!stream) { showStatus('Please start the camera first.', 'warning'); return; }

            btnScan.disabled = true;
            spinner.classList.remove('d-none');
            showStatus('Verifying face...', 'info');

            const context = canvas.getContext('2d');
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            const base64Image = canvas.toDataURL('image/jpeg', 0.8);

            try {
                const response = await fetch(VERIFY_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image: base64Image }),
                });

                const data = await response.json();

                if (data.status === 'success') {
                    showStatus('✅ Recognized! Redirecting...', 'success');
                    stopCamera();
                    setTimeout(() => { window.location.href = data.redirect || '/'; }, 800);
                } else {
                    showStatus(data.message || 'Face not recognized.', 'danger');
                    btnScan.disabled = false;
                }
            } catch (e) {
                console.error(e);
                showStatus('Server error. Please try again.', 'danger');
                btnScan.disabled = false;
            } finally {
                spinner.classList.add('d-none');
            }
        });

        // Bootstrap tab management
        const faceTabEl = document.getElementById('face-tab');
        if (faceTabEl) {
            faceTabEl.addEventListener('hidden.bs.tab', stopCamera);
        }
    })();
    </script>
{% endblock %}
