{% extends 'base_front.html.twig' %}

{% block title %}{{ event.nom|translate }} - EcoSpot{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
    <style>
        #map { 
            border: 1px solid rgba(0,0,0,0.1); 
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            z-index: 1;
        }
        .leaflet-tile-pane { opacity: 0.9; }
        .leaflet-container img { max-width: none !important; }
        .leaflet-popup-content-wrapper { border-radius: 8px; }
    </style>
{% endblock %}

{% block meta %}
    {{ parent() }}
    <meta name="event-latitude" content="{{ event.latitude ?? '48.8566' }}">
    <meta name="event-longitude" content="{{ event.longitude ?? '2.3522' }}">
{% endblock %}


{% block breadcrumb %}
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h2 class="display-4 text-primary mb-4">{{ event.nom|translate }}</h2>
            <p class="fs-5 text-white mb-4">{{ event.dateDebut ? event.dateDebut|date('l d F Y \\a\\t H:i') : '—' }} · {{ event.lieu|translate }}</p>
            <ol class="breadcrumb justify-content-center mb-0">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="{{ path('home') }}">{{ 'nav.home'|trans }}</a></li>
                <li class="breadcrumb-item"><a href="{{ path('events_index') }}" class="text-white">{{ 'nav.events'|trans }}</a></li>
                <li class="breadcrumb-item active text-white">{{ event.nom|translate|length > 30 ? event.nom|translate|slice(0, 30) ~ '…' : event.nom|translate }}</li>
            </ol>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="container-fluid blog py-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-lg-8">
                    {% if event.image %}
                        <img src="{{ asset(event.image) }}" class="img-fluid rounded mb-4 w-100" alt="{{ event.nom|translate }}" style="max-height: 400px; object-fit: cover;">
                    {% endif %}
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 p-lg-5">
                            <h2 class="h4 mb-4">{{ 'events.about'|trans }}</h2>
                            <p class="lead mb-0 text-muted">{{ event.description|translate|nl2br }}</p>
                            <dl class="row mb-0 mt-4">
                                <dt class="col-sm-3 text-muted">{{ 'events.start'|trans }}</dt>
                                <dd class="col-sm-9">{{ event.dateDebut ? event.dateDebut|date('d/m/Y H:i') : '—' }}</dd>
                                <dt class="col-sm-3 text-muted">{{ 'events.end'|trans }}</dt>
                                <dd class="col-sm-9">{{ event.dateFin ? event.dateFin|date('d/m/Y H:i') : '—' }}</dd>
                                <dt class="col-sm-3 text-muted">{{ 'events.location'|trans }}</dt>
                                <dd class="col-sm-9">{{ event.lieu|translate }}</dd>
                                <dt class="col-sm-3 text-muted">{{ 'events.capacity'|trans }}</dt>
                                <dd class="col-sm-9">
                                    <span class="badge {{ event.capacite > 0 ? 'bg-success' : 'bg-danger' }} fs-6">
                                        {{ event.capacite }} {{ 'events.seats_remaining'|trans|default('seats remaining') }}
                                    </span>
                                </dd>
                            </dl>

                            <div class="mt-5 pt-4 border-top">
                                {% if app.user %}
                                    {% if isParticipating %}
                                        <div class="alert alert-success d-flex align-items-center mb-4">
                                            <i class="fas fa-check-circle fa-2x me-3"></i>
                                            <div>
                                                <h5 class="alert-heading mb-1">You're going!</h5>
                                                <p class="mb-0 small">You are successfully registered for this event. We look forward to seeing you there!</p>
                                            </div>
                                        </div>
                                        <form action="{{ path('events_unparticipate', { slug: event.slug }) }}" method="POST">
                                            <button type="submit" class="btn btn-outline-danger btn-lg px-5 rounded-pill">
                                                <i class="fas fa-user-minus me-2"></i> Cancel Participation
                                            </button>
                                        </form>
                                    {% else %}
                                        {% if event.capacite > 0 %}
                                            <form action="{{ path('events_participate', { slug: event.slug }) }}" method="POST">
                                                <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm hover-scale">
                                                    <i class="fas fa-user-plus me-2"></i> Participate Now
                                                </button>
                                            </form>
                                        {% else %}
                                            <button class="btn btn-secondary btn-lg px-5 rounded-pill" disabled>
                                                <i class="fas fa-ban me-2"></i> Event Full
                                            </button>
                                        {% endif %}
                                    {% endif %}
                                {% else %}
                                    <div class="bg-light p-4 rounded-3 text-center">
                                        <p class="mb-3">Want to join this event? Sign in to save your spot!</p>
                                        <a href="{{ path('app_login') }}" class="btn btn-primary px-4 rounded-pill">
                                            Login to Participate
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h3 class="h5 mb-0">{{ 'events.location'|trans }}</h3>
                        </div>
                        <div class="card-body p-0">
                            <div id="map" 
                                 style="width: 100%; height: 350px; border-radius: 4px; display: block;" 
                                 data-lat="{{ event.latitude|default('48.8566') }}"
                                 data-lng="{{ event.longitude|default('2.3522') }}"
                                 data-event-name="{{ event.nom|escape('html') }}"
                                 data-event-lieu="{{ event.lieu|escape('html') }}">
                            </div>
                            <div class="p-3">
                                <p class="mb-0"><strong>{{ event.lieu|translate }}</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
                            <h3 class="h5 mb-0">Nearby Me</h3>
                            <a href="{{ path('events_nearby') }}" class="small text-primary text-decoration-none">View All</a>
                        </div>
                        <div class="card-body">
                            {% if nearbyEvents|length > 0 %}
                                <div class="list-group list-group-flush">
                                    {% for item in nearbyEvents %}
                                        <a href="{{ path('events_show', { slug: item.event.slug }) }}" class="list-group-item list-group-item-action border-0 px-0 py-3">
                                            <div class="d-flex w-100 justify-content-between align-items-start">
                                                <h6 class="mb-1 fw-bold text-dark">{{ item.event.nom|translate }}</h6>
                                                <small class="badge bg-light text-primary border">{{ item.distance }} km</small>
                                            </div>
                                            <p class="mb-1 small text-muted"><i class="fas fa-map-marker-alt me-1"></i> {{ item.event.lieu|translate|slice(0, 30) }}...</p>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div class="text-center py-3">
                                    <i class="fas fa-map-marked-alt fa-2x text-light mb-2"></i>
                                    <p class="text-muted small mb-0">No other events near you found.</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-transparent border-0 py-3">
                            <h3 class="h5 mb-0">{{ 'events.sponsors'|trans }}</h3>
                        </div>
                        <div class="card-body">
                            {% if event.sponsors|length > 0 %}
                                <ul class="list-unstyled mb-0">
                                    {% for sponsor in event.sponsors %}
                                        <li class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                            {% if sponsor.image %}
                                                <img src="{{ asset(sponsor.image) }}" alt="{{ sponsor.nom }}" class="rounded me-3" style="width: 48px; height: 48px; object-fit: cover;">
                                            {% else %}
                                                <div class="rounded me-3 d-flex align-items-center justify-content-center bg-light text-primary" style="width: 48px; height: 48px; font-weight: 600;">{{ sponsor.nom|slice(0, 1)|upper }}</div>
                                            {% endif %}
                                            <div>
                                                <strong>{{ sponsor.nom }}</strong>
                                                {% if sponsor.secteur %}
                                                    <br><span class="small text-muted">{{ sponsor.secteur }}</span>
                                                {% endif %}
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-muted mb-0">{{ 'events.no_sponsors'|trans }}</p>
                            {% endif %}
                        </div>
                    </div>
                    <a href="{{ path('events_index') }}" class="btn btn-outline-primary mb-4">
                <i class="fas fa-arrow-{{ app.request.locale == 'ar' ? 'right' : 'left' }} me-2"></i> {{ 'events.back_to_events'|trans }}
            </a>
                </div>
            </div>
        </div>
    </div>

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mapElement = document.getElementById('map');
            if (!mapElement) return;

            const lat = parseFloat(mapElement.dataset.lat) || 48.8566;
            const lng = parseFloat(mapElement.dataset.lng) || 2.3522;

            try {
                const map = L.map('map', {
                    center: [lat, lng],
                    zoom: 14,
                    scrollWheelZoom: false,
                    zoomControl: true
                });

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                    maxZoom: 19
                }).addTo(map);

                const eventName = mapElement.dataset.eventName || 'Event Location';
                const eventLieu = mapElement.dataset.eventLieu || 'Location';
                
                const marker = L.marker([lat, lng]).addTo(map)
                    .bindPopup('<strong>' + eventName + '</strong><br>' + eventLieu);
                
                // Open popup after a short delay
                setTimeout(() => marker.openPopup(), 500);

                // Ensure map is correctly sized
                const resizeObserver = new ResizeObserver(() => {
                    map.invalidateSize();
                });
                resizeObserver.observe(mapElement);
                
                // Fallback invalidation
                setTimeout(() => map.invalidateSize(), 200);
            } catch (error) {
                console.error('Leaflet error:', error);
            }
        });
    </script>
{% endblock %}

{% endblock %}
