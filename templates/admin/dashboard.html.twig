{% extends 'base_back.html.twig' %}

{% block title %}{{ 'dashboard.admin_title'|trans }} - EcoSpot{% endblock %}
{% block page_title %}{{ 'dashboard.admin_title'|trans }}{% endblock %}

{% block body %}
    <p class="text-muted mb-4">{{ 'dashboard.manage_desc'|trans }}</p>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_pending_tickets') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-clock fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.pending_tickets'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.pending_tickets_desc'|trans }}</p>
                        {% if pending_tickets_count is defined and pending_tickets_count > 0 %}<span class="badge bg-warning text-dark">{{ pending_tickets_count }}</span>{% endif %}
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_completions_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-check-double fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.completions'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.completions_desc'|trans }}</p>
                        {% if pending_completions_count is defined and pending_completions_count > 0 %}<span class="badge bg-info">{{ pending_completions_count }}</span>{% endif %}
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_blog_article_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-newspaper fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.articles'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.articles_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_blog_comment_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-comments fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.comments'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.comments_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_events_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-calendar-alt fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.events'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.events_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_users_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-users fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.users'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.users_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_sponsors_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-hand-holding-heart fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.sponsors'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.sponsors_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_blog_category_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-folder-open fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'dashboard.categories'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.categories_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('admin_blog_tag_index') }}" class="text-decoration-none">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-tags fa-3x text-primary mb-3"></i>
                         <h5 class="card-title">{{ 'common.tags'|trans }}</h5>
                         <p class="card-text small text-muted">{{ 'dashboard.tags_desc'|trans }}</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
{% endblock %}
