{% extends 'base_back.html.twig' %}

{% block title %}{{ sponsor.nom|translate }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'admin.sponsor_details'|trans }}: {{ sponsor.nom|translate }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            {% if sponsor.image %}
                <div class="mb-3">
                    <img src="{{ asset(sponsor.image) }}" alt="{{ sponsor.nom|translate }}" class="img-fluid rounded" style="max-height: 120px; object-fit: contain;">
                </div>
            {% endif %}
            <dl class="row">
                <dt class="col-sm-2">{{ 'common.title'|trans }}</dt>
                <dd class="col-sm-10">{{ sponsor.nom|translate }}</dd>

                <dt class="col-sm-2">{{ 'common.description'|trans }}</dt>
                <dd class="col-sm-10">{{ sponsor.description|translate|nl2br }}</dd>

                <dt class="col-sm-2">{{ 'events.sector'|trans }}</dt>
                <dd class="col-sm-10">{{ sponsor.secteur|translate }}</dd>

                <dt class="col-sm-2">{{ 'events.location'|trans }}</dt>
                <dd class="col-sm-10">{{ sponsor.localisation|translate }}</dd>

                {% if sponsor.evenements|length > 0 %}
                    <dt class="col-sm-2">{{ 'common.events'|trans }}</dt>
                    <dd class="col-sm-10">
                        <ul class="list-unstyled mb-0">
                            {% for event in sponsor.evenements %}
                                <li><a href="{{ path('admin_events_show', { id: event.id }) }}">{{ event.nom|translate }}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endif %}
            </dl>
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('admin_sponsors_edit', { id: sponsor.id }) }}" class="btn btn-primary">{{ 'common.edit'|trans }}</a>
                <a href="{{ path('admin_sponsors_index') }}" class="btn btn-outline-secondary">{{ 'common.back_to_list'|trans }}</a>
                <form method="post" action="{{ path('admin_sponsors_delete', { id: sponsor.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.sponsors.delete_confirm'|trans }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor.id) }}">
                    <button type="submit" class="btn btn-outline-danger">{{ 'common.delete'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
