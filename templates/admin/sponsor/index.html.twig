{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.sponsors'|trans }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'common.sponsors'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>{{ 'admin.sponsors.list'|trans }}</span>
            <a href="{{ path('admin_sponsors_new') }}" class="btn btn-primary btn-sm">{{ 'admin.sponsors.new'|trans }}</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.id'|trans }}</th>
                            <th>{{ 'common.title'|default('Name')|translate }}</th>
                            <th>{{ 'events.sector'|default('Sector')|translate }}</th>
                            <th>{{ 'events.location'|trans }}</th>
                            <th width="180">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sponsor in sponsors %}
                            <tr>
                                <td>{{ sponsor.id }}</td>
                                <td>{{ sponsor.nom|translate }}</td>
                                <td>{{ sponsor.secteur|translate }}</td>
                                <td>{{ sponsor.localisation|translate }}</td>
                                <td>
                                    <a href="{{ path('admin_sponsors_show', { id: sponsor.id }) }}" class="btn btn-outline-secondary btn-sm">{{ 'common.view'|trans }}</a>
                                    <a href="{{ path('admin_sponsors_edit', { id: sponsor.id }) }}" class="btn btn-outline-primary btn-sm">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ path('admin_sponsors_delete', { id: sponsor.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.sponsors.delete_confirm'|trans }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sponsor.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">{{ 'admin.sponsors.no_sponsors'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
