{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.edit'|trans }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'common.edit'|trans }} {{ 'common.sponsor'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
            <div class="mb-3">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom) }}
                {{ form_errors(form.nom) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.secteur) }}
                    {{ form_widget(form.secteur) }}
                    {{ form_errors(form.secteur) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.localisation) }}
                    {{ form_widget(form.localisation) }}
                    {{ form_errors(form.localisation) }}
                </div>
            </div>
            <div class="mb-3">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
                {% if sponsor.image %}
                    <p class="small text-muted mt-1">{{ 'form.current'|default('Current')|translate }}: <a href="{{ asset(sponsor.image) }}" target="_blank">{{ 'common.view'|trans }}</a></p>
                {% endif %}
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">{{ 'common.save'|trans }}</button>
                <a href="{{ path('admin_sponsors_index') }}" class="btn btn-outline-secondary">{{ 'common.cancel'|trans }}</a>
                <a href="{{ path('admin_sponsors_show', { id: sponsor.id }) }}" class="btn btn-outline-info">{{ 'common.view'|trans }}</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
