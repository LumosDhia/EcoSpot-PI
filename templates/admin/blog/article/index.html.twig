{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.articles'|trans }} - {{ 'common.admin'|trans }} EcoSpot{% endblock %}
{% block page_title %}{{ 'admin.blog_articles'|trans }}{% endblock %}

{% block body %}
    {# Admin's own articles: full control (create, edit, publish, delete) #}
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Official & Admin Articles</span>
            <a href="{{ path('admin_blog_article_new') }}" class="glass-button">
                <i class="fas fa-plus-circle me-2"></i> {{ 'admin.new_article'|trans }}
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.id'|trans }}</th>
                            <th>{{ 'common.title'|trans }}</th>
                            <th>{{ 'common.status'|trans }}</th>
                            <th>{{ 'common.created'|trans }}</th>
                            <th>{{ 'common.published'|trans }}</th>
                            <th width="220">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for article in admin_pagination %}
                            <tr>
                                <td>{{ article.id }}</td>
                                <td>{{ article.title|translate }}</td>
                                <td>
                                    {% set status = article.publicationStatus %}
                                    {% if status == 'draft' %}<span class="badge bg-secondary">{{ 'common.draft'|trans }}</span>
                                    {% elseif status == 'scheduled' %}<span class="badge bg-info">{{ 'common.scheduled'|trans }}</span>
                                    {% else %}<span class="badge bg-success">{{ 'common.published'|trans }}</span>{% endif %}
                                </td>
                                <td>{{ article.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    {% if status is defined and status == 'scheduled' and article.publishedAt %}
                                        <span class="text-info">{{ 'admin.scheduled_for'|trans({'%date%': article.publishedAt|date('d/m/Y H:i')}) }}</span>
                                    {% elseif article.publishedAt %}
                                        {{ article.publishedAt|date('d/m/Y H:i') }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_blog_article_show', { id: article.id }) }}" class="btn btn-outline-secondary btn-sm">{{ 'common.view'|trans }}</a>
                                    <a href="{{ path('admin_blog_article_edit', { id: article.id }) }}" class="btn btn-outline-primary btn-sm">{{ 'common.edit'|trans }}</a>
                                    {% if article.publicationStatus == 'draft' %}
                                        <form method="post" action="{{ path('admin_blog_article_publish', { id: article.id }) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('publish' ~ article.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm">{{ 'common.publish'|trans }}</button>
                                        </form>
                                    {% endif %}
                                    <form method="post" action="{{ path('admin_blog_article_delete', { id: article.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.delete_confirm'|trans|escape('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">{{ 'admin.no_articles_create'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="navigation d-flex justify-content-center mt-3">
                {{ knp_pagination_render(admin_pagination) }}
            </div>
        </div>
    </div>

    {# NGO articles: view, delete, or return for revision only (no edit/publish) #}
    <div class="card">
        <div class="card-header">
            <span>{{ 'admin.ngo_articles'|trans }}</span>
            <small class="text-muted d-block">{{ 'admin.ngo_articles_desc'|trans }}</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.id'|trans }}</th>
                            <th>{{ 'common.title'|trans }}</th>
                            <th>{{ 'common.writer'|trans }}</th>
                            <th>{{ 'common.status'|trans }}</th>
                            <th>{{ 'common.created'|trans }}</th>
                            <th width="220">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for article in ngo_pagination %}
                            <tr>
                                <td>{{ article.id }}</td>
                                <td>{{ article.title|translate }}</td>
                                <td>{{ article.writer ? article.writer.firstname ~ ' ' ~ article.writer.lastname : '—' }}</td>
                                <td>
                                    {% set status = article.publicationStatus %}
                                    {% if status == 'draft' %}<span class="badge bg-secondary">{{ 'common.draft'|trans }}</span>
                                    {% elseif status == 'scheduled' %}<span class="badge bg-info">{{ 'common.scheduled'|trans }}</span>
                                    {% else %}<span class="badge bg-success">{{ 'common.published'|trans }}</span>{% endif %}
                                </td>
                                <td>{{ article.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <a href="{{ path('admin_blog_article_show', { id: article.id }) }}" class="btn btn-outline-secondary btn-sm">{{ 'common.view'|trans }}</a>
                                    {% if article.publicationStatus == 'published' %}
                                        <a href="{{ path('admin_blog_article_return_revision', { id: article.id }) }}" class="btn btn-warning btn-sm">{{ 'common.return_revision'|trans }}</a>
                                    {% endif %}
                                    <form method="post" action="{{ path('admin_blog_article_delete', { id: article.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.delete_ngo_confirm'|trans|escape('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">{{ 'admin.no_ngo_articles'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="navigation d-flex justify-content-center mt-3">
                {{ knp_pagination_render(ngo_pagination) }}
            </div>
        </div>
    </div>
{% endblock %}
