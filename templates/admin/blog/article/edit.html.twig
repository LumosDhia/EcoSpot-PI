{% extends 'base_back.html.twig' %}

{% block title %}Edit article - Admin EcoSpot{% endblock %}
{% block page_title %}Edit article{% endblock %}

{% block body %}
    {{ form_start(form, { attr: { novalidate: 'novalidate', enctype: 'multipart/form-data', class: 'js-article-form-root' } }) }}
    <div class="row">
        <!-- Main Content Column -->
        <div class="col-lg-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-uppercase small text-muted mb-2">Article Title</label>
                        {{ form_widget(form.title, { attr: { class: 'form-control form-control-lg border-0 bg-light fs-2 fw-bold px-0', style: 'box-shadow: none; border-bottom: 2px solid #eee !important; border-radius: 0;' } }) }}
                        {{ form_errors(form.title) }}
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold text-uppercase small text-muted mb-2">Content Editor</label>
                        {{ form_widget(form.content) }}
                        {{ form_errors(form.content) }}
                    </div>
                </div>
            </div>

            <!-- SEO Card -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="mb-0 text-primary fw-bold"><i class="fas fa-search me-2"></i> SEO & Search Visibility</h5>
                    <button type="button" id="js-generate-seo-btn" class="btn btn-outline-primary btn-sm rounded-pill">
                        <i class="fas fa-magic me-1"></i> {{ 'form.generate_seo_btn'|trans }}
                    </button>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            {{ form_label(form.seoTitle, null, { label_attr: { class: 'fw-bold mb-0' } }) }}
                            <button type="button" id="js-generate-titles-btn" class="btn btn-link btn-sm text-primary p-0 text-decoration-none">
                                <i class="fas fa-lightbulb me-1"></i> Get AI Title Ideas
                            </button>
                        </div>
                        {{ form_widget(form.seoTitle, { attr: { class: 'form-control shadow-sm border-0 bg-light' } }) }}
                        <div id="js-title-ideas-container" class="mt-2 d-flex flex-wrap gap-2" style="display: none !important;">
                            {# AI Title Ideas will be injected here #}
                        </div>
                        {{ form_errors(form.seoTitle) }}
                        <div class="form-text mt-1"><i class="fas fa-info-circle me-1"></i> {{ 'form.seo_title_help'|trans }}</div>
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.seoDescription, null, { label_attr: { class: 'fw-bold mb-1' } }) }}
                        {{ form_widget(form.seoDescription) }}
                        {{ form_errors(form.seoDescription) }}
                        <div class="form-text mt-1"><i class="fas fa-info-circle me-1"></i> {{ 'form.seo_description_help'|trans }}</div>
                    </div>
                    <div class="mb-0">
                        {{ form_label(form.seoKeywords, null, { label_attr: { class: 'fw-bold mb-1' } }) }}
                        {{ form_widget(form.seoKeywords) }}
                        {{ form_errors(form.seoKeywords) }}
                        <div class="form-text mt-1"><i class="fas fa-info-circle me-1"></i> {{ 'form.seo_keywords_help'|trans }}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
            <!-- Publishing Actions -->
            <div class="card mb-4 shadow-sm border-0 sticky-top" style="top: 20px; z-index: 10;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-paper-plane me-2 text-primary"></i> Publishing</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        {{ form_label(form.publishMode, null, { label_attr: { class: 'fw-bold mb-2 d-block' } }) }}
                        {{ form_widget(form.publishMode) }}
                        {{ form_errors(form.publishMode) }}
                    </div>

                    <div class="mb-4 js-scheduled-wrap" style="display: none;">
                        {{ form_label(form.scheduledAt, null, { label_attr: { class: 'fw-bold mb-2 d-block' } }) }}
                        {{ form_widget(form.scheduledAt) }}
                        {{ form_errors(form.scheduledAt) }}
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i> Update Article
                        </button>
                        <div class="d-flex gap-2">
                            <a href="{{ path('admin_blog_article_show', { id: article.id }) }}" class="btn btn-outline-info flex-grow-1">
                                <i class="fas fa-eye me-1"></i> View
                            </a>
                            <a href="{{ path('admin_blog_article_index') }}" class="btn btn-outline-secondary flex-grow-1">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Media Card -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-image me-2 text-primary"></i> Hero Image</h5>
                </div>
                <div class="card-body p-4">
                    {% if article.image %}
                        <div class="mb-3">
                            <label class="fw-bold mb-2 d-block">Current Image</label>
                            <img src="{{ article.image starts with 'http' ? article.image : asset(article.image) }}" class="img-fluid rounded shadow-sm border mb-2" style="max-height: 150px; width: 100%; object-fit: cover;">
                        </div>
                    {% endif %}

                    <div class="mb-4">
                        {{ form_label(form.imageFile, null, { label_attr: { class: 'fw-bold mb-2' } }) }}
                        {{ form_widget(form.imageFile) }}
                        {{ form_errors(form.imageFile) }}
                        <div class="form-text">Upload new to replace or keep empty.</div>
                    </div>

                    <div class="mb-0">
                        <label class="fw-bold mb-2">Unsplash Library</label>
                        <div class="input-group mb-3 shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-link text-muted"></i></span>
                            {{ form_widget(form.image, { attr: { class: 'form-control border-start-0 js-image-url-field', placeholder: 'Image URL...' } }) }}
                        </div>
                        <button type="button" class="btn btn-outline-primary w-100" id="js-search-unsplash-btn">
                            <i class="fas fa-search-plus me-1"></i> Browse Unsplash
                        </button>
                        
                        {# Unsplash Search Panel #}
                        <div id="unsplash-search-panel" class="mt-3 p-3 border rounded-3 bg-light shadow-sm" style="display: none;">
                            <div class="input-group mb-3">
                                <input type="text" id="unsplash-search-input" class="form-control" placeholder="Search eco photos...">
                                <button type="button" id="unsplash-search-submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                            </div>
                            <div id="unsplash-results" class="row g-2" style="max-height: 250px; overflow-y: auto;">
                                <p class="text-muted text-center py-3 extra-small">Enter keywords...</p>
                            </div>
                            <div id="unsplash-pagination" class="mt-2 d-flex justify-content-center gap-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tags & Categories -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-tags me-2 text-primary"></i> Organization</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="fw-bold mb-2 d-block"><i class="fas fa-folder-open me-1 text-muted"></i> Category</label>
                        <div class="category-selection border rounded p-3 bg-light">
                            <div class="form-check-list-scrollable" style="max-height: 150px; overflow-y: auto;">
                                {{ form_widget(form.category) }}
                            </div>
                            <div class="mt-3">
                                {{ form_widget(form.newCategory, { attr: { class: 'form-control form-control-sm', placeholder: '+ New category...' } }) }}
                            </div>
                        </div>
                        {{ form_errors(form.category) }}
                    </div>

                    <div class="mb-0">
                        <label class="fw-bold mb-2 d-block"><i class="fas fa-hashtag me-1 text-muted"></i> Tags</label>
                        <div class="tags-selection border rounded p-3 bg-light">
                            <div class="form-check-list-scrollable" style="max-height: 150px; overflow-y: auto;">
                                {{ form_widget(form.tags) }}
                            </div>
                            <div class="mt-3">
                                {{ form_widget(form.newTags, { attr: { class: 'form-control form-control-sm', placeholder: '+ Add tags...' } }) }}
                            </div>
                        </div>
                        {{ form_errors(form.tags) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
        </div>
    </div>

    <script src="https://cdn.tiny.cloud/1/gjqfg77yk8o4mrwj66nk2auuw1ruj96uzsm32cxfp6quajrb/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var wrap = document.querySelector('.js-scheduled-wrap');
        var select = document.querySelector('#article_publishMode');
        function toggleScheduled() {
          wrap.style.display = select && select.value === 'schedule' ? 'block' : 'none';
        }
        if (select) {
          select.addEventListener('change', toggleScheduled);
          toggleScheduled();
        }

        tinymce.init({
          selector: '.article-content-editor',
          height: 400,
          plugins: 'lists link image code table',
          toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright | bullist numlist | link image | code',
          content_style: 'body { font-family: Roboto, sans-serif; font-size: 14px; }',
          images_upload_url: '{{ url('blog_editor_upload_image') }}',
          images_upload_credentials: true,
          automatic_uploads: true,
          images_reuse_filename: true,
        });

        // Unsplash Search JS
        const searchBtn = document.querySelector('#js-search-unsplash-btn');
        const searchPanel = document.querySelector('#unsplash-search-panel');
        const searchInput = document.querySelector('#unsplash-search-input');
        const searchSubmit = document.querySelector('#unsplash-search-submit');
        const resultsContainer = document.querySelector('#unsplash-results');
        const paginationContainer = document.querySelector('#unsplash-pagination');
        const urlField = document.querySelector('.js-image-url-field');

        if (searchBtn) {
          searchBtn.addEventListener('click', () => {
            searchPanel.style.display = searchPanel.style.display === 'none' ? 'block' : 'none';
          });
        }

        const performSearch = (page = 1) => {
          const query = searchInput.value.trim();
          if (!query) return;

          resultsContainer.innerHTML = '<div class="col-12 text-center py-3"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Searching Unsplash...</p></div>';
          paginationContainer.innerHTML = '';

          fetch(`{{ path('blog_api_unsplash_search') }}?q=${encodeURIComponent(query)}&page=${page}`)
            .then(res => res.json())
            .then(data => {
              resultsContainer.innerHTML = '';
              if (!data.results || data.results.length === 0) {
                resultsContainer.innerHTML = '<p class="text-muted text-center py-3">No results found.</p>';
                return;
              }

              data.results.forEach(photo => {
                const col = document.createElement('div');
                col.className = 'col-4 col-md-3';
                col.innerHTML = `
                  <div class="unsplash-item" style="cursor: pointer; position: relative;">
                    <img src="${photo.urls.thumb}" class="img-fluid rounded border" alt="${photo.alt_description}" style="height: 100px; width: 100%; object-fit: cover;">
                    <div class="small text-muted" style="font-size: 10px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">by ${photo.user.name}</div>
                  </div>
                `;
                col.querySelector('.unsplash-item').addEventListener('click', () => {
                  urlField.value = photo.urls.regular;
                  searchPanel.style.display = 'none';
                });
                resultsContainer.appendChild(col);
              });

              // Pagination
              if (data.total_pages > 1) {
                const maxPages = Math.min(data.total_pages, 5);
                for (let i = 1; i <= maxPages; i++) {
                  const pBtn = document.createElement('button');
                  pBtn.type = 'button';
                  pBtn.className = `btn btn-sm ${i === page ? 'btn-primary' : 'btn-outline-primary'}`;
                  pBtn.innerText = i;
                  pBtn.addEventListener('click', () => performSearch(i));
                  paginationContainer.appendChild(pBtn);
                }
              }
            })
            .catch(err => {
              resultsContainer.innerHTML = '<p class="text-danger text-center py-3">Failed to fetch results.</p>';
              console.error(err);
            });
        };

        if (searchSubmit) {
          searchSubmit.addEventListener('click', () => performSearch(1));
          searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
              e.preventDefault();
              performSearch(1);
            }
          });
        }

        document.querySelector('form')?.addEventListener('submit', function() {
          if (window.tinymce) window.tinymce.triggerSave();
        });

        // AI SEO Generation JS
        const generateSeoBtn = document.querySelector('#js-generate-seo-btn');
        const generateTitlesBtn = document.querySelector('#js-generate-titles-btn');
        const titleIdeasContainer = document.querySelector('#js-title-ideas-container');
        
        const seoTitleField = document.querySelector('#article_seoTitle');
        const seoDescField = document.querySelector('#article_seoDescription');
        const seoKeysField = document.querySelector('#article_seoKeywords');
        const titleField = document.querySelector('#article_title');

        if (generateTitlesBtn) {
            generateTitlesBtn.addEventListener('click', function() {
                const title = titleField.value.trim();
                if (window.tinymce) window.tinymce.triggerSave();
                const content = document.querySelector('.article-content-editor').value.trim();

                if (!title || !content) {
                    alert('Please enter a title and some content first.');
                    return;
                }

                generateTitlesBtn.disabled = true;
                generateTitlesBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Thinking...';

                fetch('{{ path("blog_api_seo_generate_titles") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, content })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert(data.error);
                    } else {
                        titleIdeasContainer.innerHTML = '';
                        titleIdeasContainer.style.setProperty('display', 'flex', 'important');
                        
                        data.forEach(t => {
                            const badge = document.createElement('button');
                            badge.type = 'button';
                            badge.className = 'btn btn-sm btn-outline-info rounded-pill';
                            badge.innerText = t;
                            badge.addEventListener('click', () => {
                                seoTitleField.value = t;
                            });
                            titleIdeasContainer.appendChild(badge);
                        });
                    }
                })
                .finally(() => {
                    generateTitlesBtn.disabled = false;
                    generateTitlesBtn.innerHTML = '<i class="fas fa-lightbulb me-1"></i> Get AI Title Ideas';
                });
            });
        }

        if (generateSeoBtn) {
            generateSeoBtn.addEventListener('click', function() {
                const title = titleField.value.trim();
                if (window.tinymce) window.tinymce.triggerSave();
                const content = document.querySelector('.article-content-editor').value.trim();

                if (!title || !content) {
                    alert('Please enter a title and some content first.');
                    return;
                }

                generateSeoBtn.disabled = true;
                const originalHtml = generateSeoBtn.innerHTML;
                generateSeoBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> {{ "form.generating_seo"|trans }}';

                fetch('{{ path("blog_api_seo_generate") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, content })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.error) {
                        alert('Error: ' + data.error);
                    } else {
                        if (data.description) seoDescField.value = data.description;
                        if (data.keywords) seoKeysField.value = data.keywords;
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Failed to generate SEO. Check console for details.');
                })
                .finally(() => {
                    generateSeoBtn.disabled = false;
                    generateSeoBtn.innerHTML = originalHtml;
                });
            });
        }
      });
    </script>
{% endblock %}
