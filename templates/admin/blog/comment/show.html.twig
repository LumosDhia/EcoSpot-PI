{% extends 'base_back.html.twig' %}

{% block title %}Comment - Admin EcoSpot{% endblock %}
{% block page_title %}Comment #{{ comment.id }}{% endblock %}

{% block body %}
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-2">Id</dt>
                <dd class="col-sm-10">{{ comment.id }}</dd>
                <dt class="col-sm-2">Author</dt>
                <dd class="col-sm-10">{{ comment.author }}</dd>
                <dt class="col-sm-2">Content</dt>
                <dd class="col-sm-10">{{ comment.content|nl2br }}</dd>
                <dt class="col-sm-2">Article</dt>
                <dd class="col-sm-10">
                    <a href="{{ path('admin_blog_article_show', { id: comment.article.id }) }}">{{ comment.article.title }}</a>
                </dd>
                <dt class="col-sm-2">Created at</dt>
                <dd class="col-sm-10">{{ comment.createdAt|date('d/m/Y H:i') }}</dd>
            </dl>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_blog_comment_index') }}" class="btn btn-outline-secondary">Back to list</a>
        <form method="post" action="{{ path('admin_blog_comment_delete', { id: comment.id }) }}" class="d-inline" onsubmit="return confirm('Delete this comment?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
{% endblock %}
