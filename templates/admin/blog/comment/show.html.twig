{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.comment'|trans }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'common.comment'|trans }} #{{ comment.id }}{% endblock %}

{% block body %}
    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-2">{{ 'common.id'|trans }}</dt>
                <dd class="col-sm-10">{{ comment.id }}</dd>
                <dt class="col-sm-2">{{ 'common.author'|trans }}</dt>
                <dd class="col-sm-10">{{ comment.author }}</dd>
                <dt class="col-sm-2">{{ 'common.content'|trans }}</dt>
                <dd class="col-sm-10">{{ comment.content|translate|nl2br }}</dd>
                <dt class="col-sm-2">{{ 'common.article'|trans }}</dt>
                <dd class="col-sm-10">
                    <a href="{{ path('admin_blog_article_show', { id: comment.article.id }) }}">{{ comment.article.title|translate }}</a>
                </dd>
                <dt class="col-sm-2">{{ 'common.created'|trans }}</dt>
                <dd class="col-sm-10">{{ comment.createdAt|date('d/m/Y H:i') }}</dd>
            </dl>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('admin_blog_comment_index') }}" class="btn btn-outline-secondary">{{ 'common.back_to_list'|trans }}</a>
        <form method="post" action="{{ path('admin_blog_comment_delete', { id: comment.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.delete_comment_confirm'|trans }}');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
            <button type="submit" class="btn btn-outline-danger">{{ 'common.delete'|trans }}</button>
        </form>
    </div>
{% endblock %}
