{% extends 'base_back.html.twig' %}

{% block title %}Comments - Admin EcoSpot{% endblock %}
{% block page_title %}Comments{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <span>Comment list</span>
            <small class="text-muted d-block mt-1">Comments are created under blog articles. Here you can view and delete them.</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Author</th>
                            <th>Article</th>
                            <th>Date</th>
                            <th>Flagged</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            <tr class="{{ comment.flagged ? 'table-warning' : '' }}">
                                <td>{{ comment.id }}</td>
                                <td>{{ comment.author }}</td>
                                <td>
                                    <a href="{{ path('admin_blog_article_show', { id: comment.article.id }) }}">{{ comment.article.title }}</a>
                                </td>
                                <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{% if comment.flagged %}<span class="badge bg-warning">Flagged</span>{% endif %}</td>
                                <td>
                                    <a href="{{ path('admin_blog_comment_show', { id: comment.id }) }}" class="btn btn-outline-secondary btn-sm">View</a>
                                    <form method="post" action="{{ path('admin_blog_comment_delete', { id: comment.id }) }}" class="d-inline" onsubmit="return confirm('Delete this comment?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No comments.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
