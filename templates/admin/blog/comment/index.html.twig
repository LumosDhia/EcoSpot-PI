{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.comments'|trans }} - {{ 'common.admin'|trans }} EcoSpot{% endblock %}
{% block page_title %}{{ 'common.comments'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <span>{{ 'admin.comment_list'|trans }}</span>
            <small class="text-muted d-block mt-1">{{ 'admin.comment_desc'|trans }}</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.id'|trans }}</th>
                            <th>{{ 'common.author'|trans }}</th>
                            <th>{{ 'common.article'|trans }}</th>
                            <th>{{ 'common.date'|trans }}</th>
                            <th>{{ 'common.flagged'|trans }}</th>
                            <th width="180">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            <tr class="{{ comment.flagged ? 'table-warning' : '' }}">
                                <td>{{ comment.id }}</td>
                                <td>{{ comment.author }}</td>
                                <td>
                                    <a href="{{ path('admin_blog_article_show', { id: comment.article.id }) }}">{{ comment.article.title|translate }}</a>
                                </td>
                                <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                <td>{% if comment.flagged %}<span class="badge bg-warning">{{ 'common.flagged'|trans }}</span>{% endif %}</td>
                                <td>
                                    <a href="{{ path('admin_blog_comment_show', { id: comment.id }) }}" class="btn btn-outline-secondary btn-sm">{{ 'common.view'|trans }}</a>
                                    <form method="post" action="{{ path('admin_blog_comment_delete', { id: comment.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.delete_comment_confirm'|trans|escape('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">{{ 'admin.no_comments'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-3 d-flex justify-content-center">
                {{ knp_pagination_render(comments) }}
            </div>
        </div>
    </div>
{% endblock %}
