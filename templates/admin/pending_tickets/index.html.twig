{% extends 'base_back.html.twig' %}

{% block title %}Pending Tickets Review - EcoSpot Admin{% endblock %}
{% block page_title %}Pending Tickets Review{% endblock %}

{% block body %}
    <div class="mb-4">
        <p class="text-muted">Review, publish, or send tickets back to the user with corrective notes.</p>
        
        <div class="row g-3 align-items-center bg-white p-3 rounded-4 shadow-sm mx-0">
            <div class="col-lg-5 col-md-6">
                <form action="{{ path('admin_pending_tickets') }}" method="get" class="m-0">
                    <div class="input-group bg-light rounded-pill px-3 py-1">
                        <span class="input-group-text bg-transparent border-0 text-muted">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" name="q" value="{{ currentQuery }}" class="form-control bg-transparent border-0 py-2 shadow-none" placeholder="Filter by title, description..." style="font-size: 0.95rem;">
                        {% if currentQuery %}
                            <a href="{{ path('admin_pending_tickets', {sort: currentSort}) }}" class="btn btn-link text-muted p-2" title="Clear Search">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
            
            <div class="col-lg-7 col-md-6 d-flex justify-content-md-end align-items-center gap-3">
                <form action="{{ path('admin_pending_tickets') }}" method="get" class="d-flex align-items-center gap-2 m-0">
                    <input type="hidden" name="q" value="{{ currentQuery }}">
                    <label class="text-muted small fw-bold text-uppercase mb-0 me-2" style="letter-spacing: 0.5px;">Sort By:</label>
                    <select name="sort" class="form-select border-0 bg-light rounded-pill px-3 py-2 shadow-none" onchange="this.form.submit()" style="min-width: 160px; font-size: 0.9rem; cursor: pointer;">
                        <option value="newest" {{ currentSort == 'newest' ? 'selected' }}>Newest First</option>
                        <option value="oldest" {{ currentSort == 'oldest' ? 'selected' }}>Oldest First</option>
                        <option value="priority_high" {{ currentSort == 'priority_high' ? 'selected' }}>Priority: High to Low</option>
                        <option value="priority_low" {{ currentSort == 'priority_low' ? 'selected' }}>Priority: Low to High</option>
                    </select>
                </form>

                {% if currentQuery or currentSort != 'newest' %}
                    <div class="vr mx-2 h-50 d-none d-lg-block opacity-10"></div>
                    <a href="{{ path('admin_pending_tickets') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 border-0 bg-light-hover transition-all">
                        <i class="fas fa-undo-alt me-1"></i> Reset Filters
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if tickets is empty %}
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="fas fa-check-circle text-success fs-1 mb-3 opacity-25"></i>
                <h5 class="text-muted">In-box Zero!</h5>
                <p class="mb-0">No pending or sent-back tickets require your attention right now.</p>
            </div>
        </div>
    {% else %}
        <div class="row g-4">
            {% for ticket in tickets %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm hover-shadow transition-all">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-5">
                                    <div class="d-flex align-items-center gap-3 mb-2">
                                        <span class="badge bg-{{ ticket.status.getBadgeClass() }}-subtle text-{{ ticket.status.getBadgeClass() }} px-3 py-2 rounded-pill">
                                            {{ ticket.status.getLabel()|upper }}
                                        </span>
                                        {% if ticket.isSpam %}
                                            <span class="badge bg-danger rounded-pill px-3 py-2">
                                                <i class="fas fa-exclamation-triangle me-1"></i> SPAM
                                            </span>
                                        {% endif %}
                                        <span class="text-muted small"><i class="fas fa-clock me-1"></i> {{ ticket.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                    <h5 class="mb-1 text-dark fw-bold">{{ ticket.title }}</h5>
                                    <p class="text-muted small mb-0">{{ ticket.description|slice(0, 120) }}{% if ticket.description|length > 120 %}...{% endif %}</p>
                                </div>
                                
                                <div class="col-md-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="avatar-sm bg-eco-forest rounded-circle text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            {{ ticket.user.firstname|first }}{{ ticket.user.lastname|first }}
                                        </div>
                                        <div>
                                            <div class="fw-semibold small">{{ ticket.user.firstname }} {{ ticket.user.lastname }}</div>
                                            <div class="text-muted" style="font-size: 0.7rem;">{{ ticket.user.email }}</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small">Priority:</span> 
                                        <span class="priority-badge priority-{{ ticket.priority.value|lower }}">
                                            <i class="fas fa-{{ ticket.priority.value == 'LOW' ? 'leaf' : (ticket.priority.value == 'MEDIUM' ? 'info-circle' : (ticket.priority.value == 'HIGH' ? 'exclamation-circle' : 'bolt')) }}"></i>
                                            {{ ticket.priority.getLabel() }}
                                        </span>
                                    </div>
                                </div>

                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    <div class="btn-group gap-2">
                                        <a href="{{ path('admin_ticket_show', { id: ticket.id }) }}" class="btn btn-outline-info rounded-pill px-3" title="Review Creative">
                                            <i class="fas fa-eye me-1"></i> View
                                        </a>
                                        <a href="{{ path('admin_ticket_edit', { id: ticket.id }) }}" class="btn btn-outline-primary rounded-pill px-3" title="Edit with AI">
                                            <i class="fas fa-magic me-1"></i> Edit
                                        </a>
                                        
                                        <div class="dropdown d-inline">
                                            <button class="btn btn-dark rounded-pill px-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Approve
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                                <li>
                                                    <form action="{{ path('admin_pending_ticket_publish', { id: ticket.id }) }}" method="post" onsubmit="return confirm('Publish this ticket officially?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('pending-ticket-publish-' ~ ticket.id) }}">
                                                        <button type="submit" class="dropdown-item text-success">
                                                            <i class="fas fa-check-circle me-2"></i> Publish Now
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-warning" href="{{ path('admin_pending_ticket_send_back', { id: ticket.id }) }}">
                                                        <i class="fas fa-undo me-2"></i> Send Back with Note
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="{{ path('admin_pending_ticket_refuse', { id: ticket.id }) }}">
                                                        <i class="fas fa-times-circle me-2"></i> Refuse
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {% if ticket.adminNotes %}
                                <div class="mt-3 p-2 bg-light rounded border-start border-4 border-warning small">
                                    <strong class="text-warning"><i class="fas fa-sticky-note me-1"></i> Current Admin Note:</strong> 
                                    <span class="text-muted italic">"{{ ticket.adminNotes }}"</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <style>
        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
            z-index: 10;
            position: relative;
        }
        .transition-all {
            transition: all 0.3s ease;
        }
        /* Ensure card stays on top when dropdown is open */
        .card:has(.dropdown.show) {
            z-index: 1050 !important;
            position: relative;
        }
        .bg-pending-subtle { background-color: #fff3cd; }
        .bg-sent_back-subtle { background-color: #f8d7da; }
        .text-sent_back { color: #842029; }
    </style>
{% endblock %}
