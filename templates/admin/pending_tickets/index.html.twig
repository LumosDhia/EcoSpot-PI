{% extends 'base_back.html.twig' %}

{% block title %}{{ 'admin.pending_tickets.title'|trans }} - EcoSpot Admin{% endblock %}
{% block page_title %}{{ 'admin.pending_tickets.title'|trans }}{% endblock %}

{% block body %}
    <p class="text-muted mb-4">{{ 'admin.pending_tickets.desc'|trans }}</p>

    {% if tickets is empty %}
        <div class="alert alert-info">{{ 'admin.pending_tickets.no_tickets'|trans }}</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>{{ 'common.title'|trans }}</th>
                        <th>{{ 'common.user'|default('User')|translate }}</th>
                        <th>{{ 'common.status'|trans }}</th>
                        <th>{{ 'common.domain'|default('Domain')|translate }}</th>
                        <th>{{ 'common.created'|trans }}</th>
                        <th class="text-end">{{ 'common.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr>
                            <td>
                                <strong>{{ ticket.title|translate }}</strong>
                                <br><small class="text-muted">{{ (ticket.description|translate)|slice(0, 80) }}{% if (ticket.description|translate)|length > 80 %}...{% endif %}</small>
                            </td>
                            <td>{{ ticket.user.firstname }} {{ ticket.user.lastname }}<br><small>{{ ticket.user.email }}</small></td>
                            <td><span class="badge bg-{{ ticket.status.getBadgeClass() }}">{{ ticket.status.getLabel()|translate }}</span></td>
                            <td>{{ ticket.domain.getLabel()|translate }}</td>
                            <td>{{ ticket.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="text-end">
                                <form action="{{ path('admin_pending_ticket_publish', { id: ticket.id }) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('pending-ticket-publish-' ~ ticket.id) }}">
                                    <button type="submit" class="btn btn-sm btn-success">{{ 'admin.pending_tickets.publish'|trans }}</button>
                                </form>
                                <a href="{{ path('admin_pending_ticket_send_back', { id: ticket.id }) }}" class="btn btn-sm btn-warning">{{ 'admin.pending_tickets.send_back'|trans }}</a>
                                <a href="{{ path('admin_pending_ticket_refuse', { id: ticket.id }) }}" class="btn btn-sm btn-danger">{{ 'admin.pending_tickets.refuse'|trans }}</a>
                            </td>
                        </tr>
                        {% if ticket.adminNotes %}
                            <tr class="table-light">
                                <td colspan="6" class="small">
                                    <strong>{{ 'tickets.admin_note'|trans }}:</strong> {{ ticket.adminNotes|translate }}
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
