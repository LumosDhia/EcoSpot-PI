{% extends 'base_back.html.twig' %}

{% block title %}Users - EcoSpot Admin{% endblock %}
{% block page_title %}Users{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">Manage user accounts: create users, change their type, or remove them.</p>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-sm">New user</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.firstname }} {{ user.lastname }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger">Administrator</span>
                            {% elseif 'ROLE_NGO' in user.roles %}
                                <span class="badge bg-info">NGO</span>
                            {% else %}
                                <span class="badge bg-secondary">Normal user</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.isTimedOut %}
                                <span class="badge bg-warning text-dark" title="Until {{ user.timeoutUntil|date('d/m/Y H:i') }}">
                                    <i class="fas fa-clock me-1"></i> Timeout
                                </span>
                            {% else %}
                                <span class="badge bg-success-subtle text-success">Active</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                {% if 'ROLE_NGO' in user.roles %}
                                    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#ngoModal{{ user.id }}" title="Edit NGO Info">
                                        <i class="fas fa-building"></i>
                                    </button>
                                    
                                    <!-- Modal -->
                                    <div class="modal fade text-start" id="ngoModal{{ user.id }}" tabindex="-1" aria-hidden="true">
                                      <div class="modal-dialog">
                                        <div class="modal-content">
                                          <div class="modal-header">
                                            <h5 class="modal-title">Edit NGO Description - {{ user.firstname }}</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                          </div>
                                          <form action="{{ path('admin_user_edit_ngo_description', {id: user.id}) }}" method="post">
                                              <div class="modal-body">
                                                  <input type="hidden" name="_token" value="{{ csrf_token('edit_ngo_desc' ~ user.id) }}">
                                                  <div class="mb-3">
                                                      <label class="form-label">Description (for AI matching):</label>
                                                      <textarea name="ngo_description" class="form-control" rows="4">{{ user.ngoDescription }}</textarea>
                                                  </div>
                                              </div>
                                              <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-primary">Save changes</button>
                                              </div>
                                          </form>
                                        </div>
                                      </div>
                                    </div>
                                {% endif %}

                                <a href="{{ path('admin_user_edit_role', { id: user.id }) }}" class="btn btn-sm btn-outline-primary" title="Edit Role">
                                    <i class="fas fa-user-tag"></i>
                                </a>
                                
                                {% if user.id != app.user.id %}
                                    {% if user.isTimedOut %}
                                        <form method="post" action="{{ path('admin_user_remove_timeout', { id: user.id }) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('remove-timeout' ~ user.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Remove Timeout">
                                                <i class="fas fa-user-check"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('admin_user_timeout', { id: user.id }) }}" class="d-inline" onsubmit="return confirm('Put this user in a 24-hour timeout? They will be blocked from creating tickets.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('timeout' ~ user.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Put in Timeout">
                                                <i class="fas fa-user-slash"></i>
                                            </button>
                                        </form>
                                    {% endif %}

                                    <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" class="d-inline" onsubmit="return confirm('Remove this user? This cannot be undone.');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
