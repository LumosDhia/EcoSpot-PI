{% extends 'base_back.html.twig' %}

{% block title %}Users - EcoSpot Admin{% endblock %}
{% block page_title %}Users Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .eco-card {
            background: #ffffff;
            border-radius: 20px;
            border: 1px solid rgba(45, 106, 79, 0.08);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
            overflow: hidden;
            margin-bottom: 2rem;
        }
        
        .eco-table-header {
            background-color: #f8faf9;
            border-bottom: 2px solid rgba(45, 106, 79, 0.05);
        }
        
        .eco-table-header th {
            color: var(--eco-dark-green);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            padding: 1.25rem 1rem;
        }

        .user-row {
            transition: all 0.2s ease;
            vertical-align: middle;
        }

        .user-row:hover {
            background-color: rgba(82, 183, 136, 0.03);
        }

        .user-row td {
            padding: 1.25rem 1rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.03);
        }

        .user-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--eco-mint) 0%, var(--eco-forest) 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            box-shadow: 0 4px 12px rgba(45, 106, 79, 0.2);
        }

        .role-badge {
            padding: 0.5rem 0.85rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.75rem;
        }

        .role-admin { background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid rgba(220, 53, 69, 0.1); }
        .role-ngo { background-color: rgba(45, 106, 79, 0.1); color: var(--eco-forest); border: 1px solid rgba(45, 106, 79, 0.1); }
        .role-user { background-color: rgba(108, 117, 125, 0.1); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.1); }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.4rem 0.75rem;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
        }

        .status-active { background-color: #d8f3dc; color: #1b4332; }
        .status-timeout { background-color: #fff3cd; color: #856404; }

        .eco-action-btn {
            width: 36px;
            height: 36px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid transparent;
        }

        .eco-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .btn-edit-role { background-color: #e9ecef; color: #495057; }
        .btn-edit-role:hover { background-color: var(--eco-forest); color: white; }

        .btn-ngo-info { background-color: rgba(82, 183, 136, 0.1); color: var(--eco-forest); }
        .btn-ngo-info:hover { background-color: var(--eco-forest); color: white; }

        .btn-timeout { background-color: rgba(255, 193, 7, 0.1); color: #856404; }
        .btn-timeout:hover { background-color: #ffc107; color: white; }

        .btn-remove-timeout { background-color: rgba(40, 167, 69, 0.1); color: #155724; }
        .btn-remove-timeout:hover { background-color: #28a745; color: white; }

        .btn-delete { background-color: rgba(220, 53, 69, 0.1); color: #dc3545; }
        .btn-delete:hover { background-color: #dc3545; color: white; }

        .search-wrap {
            position: relative;
            max-width: 300px;
        }

        .search-wrap i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
        }

        .search-wrap .form-control {
            padding-left: 35px;
            border-radius: 12px;
            border: 1px solid rgba(45, 106, 79, 0.15);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="eco-card">
        <div class="p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">User Directory</h4>
                <p class="text-muted small mb-0">Manage roles, set restrictions, and organize platform members.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('admin_user_new') }}" class="glass-button">
                    <i class="fas fa-plus-circle me-2"></i> Create New User
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="eco-table-header">
                    <tr>
                        <th>Identity</th>
                        <th>User Type</th>
                        <th>Account Status</th>
                        <th class="text-end">Management</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr class="user-row">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-avatar">
                                        {{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ user.firstname }} {{ user.lastname }}</div>
                                        <div class="text-muted small"><i class="far fa-envelope me-1"></i>{{ user.email }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="role-badge role-admin"><i class="fas fa-shield-alt me-1"></i> Administrator</span>
                                {% elseif 'ROLE_NGO' in user.roles %}
                                    <span class="role-badge role-ngo"><i class="fas fa-building me-1"></i> NGO Partener</span>
                                {% else %}
                                    <span class="role-badge role-user"><i class="fas fa-user me-1"></i> Community Member</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.isTimedOut %}
                                    <span class="status-badge status-timeout" title="Restricted until {{ user.timeoutUntil|date('d/m/Y H:i') }}">
                                        <i class="fas fa-exclamation-triangle"></i> Timeout
                                    </span>
                                {% else %}
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> Active
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    {% if 'ROLE_NGO' in user.roles %}
                                        <button type="button" class="eco-action-btn btn-ngo-info" data-bs-toggle="modal" data-bs-target="#ngoModal{{ user.id }}" title="NGO Description">
                                            <i class="fas fa-info-circle"></i>
                                        </button>
                                        
                                        <!-- Modal -->
                                        <div class="modal fade text-start" id="ngoModal{{ user.id }}" tabindex="-1" aria-hidden="true">
                                          <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow" style="border-radius: 20px;">
                                              <div class="modal-header border-bottom-0 pb-0">
                                                <h5 class="modal-title fw-bold">NGO Information</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                              </div>
                                              <form action="{{ path('admin_user_edit_ngo_description', {id: user.id}) }}" method="post">
                                                  <div class="modal-body">
                                                      <input type="hidden" name="_token" value="{{ csrf_token('edit_ngo_desc' ~ user.id) }}">
                                                      <div class="mb-3">
                                                          <label class="form-label small text-muted">NGO Description (used for AI Ticket Matching):</label>
                                                          <textarea name="ngo_description" class="form-control" rows="4" style="border-radius: 12px;">{{ user.ngoDescription }}</textarea>
                                                      </div>
                                                  </div>
                                                  <div class="modal-footer border-top-0 pt-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 12px;">Cancel</button>
                                                    <button type="submit" class="btn btn-primary" style="background: var(--eco-forest); border: none; border-radius: 12px; padding: 0.5rem 1.5rem;">Update Info</button>
                                                  </div>
                                              </form>
                                            </div>
                                          </div>
                                        </div>
                                    {% endif %}

                                    <a href="{{ path('admin_user_edit_role', { id: user.id }) }}" class="eco-action-btn btn-edit-role" title="Change Role">
                                        <i class="fas fa-user-tag"></i>
                                    </a>
                                    
                                    {% if user.id != app.user.id %}
                                        {% if user.isTimedOut %}
                                            <form method="post" action="{{ path('admin_user_remove_timeout', { id: user.id }) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('remove-timeout' ~ user.id) }}">
                                                <button type="submit" class="eco-action-btn btn-remove-timeout" title="Lift Restriction">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            </form>
                                        {% else %}
                                            <form method="post" action="{{ path('admin_user_timeout', { id: user.id }) }}" class="d-inline" onsubmit="return confirm('Suspend user permissions for 24 hours?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('timeout' ~ user.id) }}">
                                                <button type="submit" class="eco-action-btn btn-timeout" title="24h Timeout">
                                                    <i class="fas fa-user-clock"></i>
                                                </button>
                                            </form>
                                        {% endif %}

                                        <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" class="d-inline" onsubmit="return confirm('Permanently remove this user account? This cannot be undone.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button type="submit" class="eco-action-btn btn-delete" title="Delete Account">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <i class="fas fa-users fa-3x text-light mb-3 d-block"></i>
                                <p class="text-muted">No users found in the directory.</p>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
