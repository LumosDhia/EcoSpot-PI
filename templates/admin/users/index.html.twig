{% extends 'base_back.html.twig' %}

{% block title %}{{ 'admin.users.title'|trans }} - EcoSpot Admin{% endblock %}
{% block page_title %}{{ 'admin.users.title'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <p class="text-muted mb-0">{{ 'admin.users.desc'|trans }}</p>
        <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-sm">{{ 'admin.users.new_user'|trans }}</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>{{ 'security.email'|trans }}</th>
                    <th>{{ 'common.title'|trans }}</th>
                    <th>{{ 'admin.users.type'|trans }}</th>
                    <th class="text-end">{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.firstname }} {{ user.lastname }}</td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-danger">{{ 'admin.users.admin'|trans }}</span>
                            {% elseif 'ROLE_NGO' in user.roles %}
                                <span class="badge bg-info">{{ 'admin.users.ngo'|trans }}</span>
                            {% else %}
                                <span class="badge bg-secondary">{{ 'admin.users.user'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('admin_user_edit_role', { id: user.id }) }}" class="btn btn-sm btn-outline-primary">{{ 'admin.users.change_type'|trans }}</a>
                            {% if user.id != app.user.id %}
                                <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.users.delete_confirm'|trans }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'common.delete'|trans }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
