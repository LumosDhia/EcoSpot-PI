{% extends 'base_back.html.twig' %}

{% block title %}Change user type - EcoSpot Admin{% endblock %}
{% block page_title %}Change user type{% endblock %}

{% block body %}
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-0"><strong>{{ user.email }}</strong> — {{ user.firstname }} {{ user.lastname }}</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_row(form.userType) }}
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary">Cancel</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
