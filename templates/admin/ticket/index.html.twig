{% extends 'base_back.html.twig' %}

{% block title %}All Tickets - EcoSpot Admin{% endblock %}
{% block page_title %}All Tickets Management{% endblock %}

{% block body %}
    <div class="mb-4">
        <p class="text-muted">Monitor and manage all citizen tickets across the entire platform.</p>
        
        <div class="row g-3 align-items-center bg-white p-3 rounded-4 shadow-sm mx-0 mb-4 border border-light">
            <div class="col-lg-5 col-md-6">
                <form action="{{ path('admin_ticket_index') }}" method="get" class="m-0">
                    <div class="input-group bg-light rounded-pill px-3 py-1">
                        <span class="input-group-text bg-transparent border-0 text-muted">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" name="q" value="{{ currentQuery }}" class="form-control bg-transparent border-0 py-2 shadow-none" placeholder="Filter all tickets..." style="font-size: 0.95rem;">
                        {% if currentQuery %}
                            <a href="{{ path('admin_ticket_index', {sort: currentSort}) }}" class="btn btn-link text-muted p-2" title="Clear Search">
                                <i class="fas fa-times-circle"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
            
            <div class="col-lg-7 col-md-6 d-flex justify-content-md-end align-items-center gap-3">
                <form action="{{ path('admin_ticket_index') }}" method="get" class="d-flex align-items-center gap-2 m-0">
                    <input type="hidden" name="q" value="{{ currentQuery }}">
                    <label class="text-muted small fw-bold text-uppercase mb-0 me-2" style="letter-spacing: 0.5px;">Sort By:</label>
                    <select name="sort" class="form-select border-0 bg-light rounded-pill px-3 py-2 shadow-none" onchange="this.form.submit()" style="min-width: 160px; font-size: 0.9rem; cursor: pointer;">
                        <option value="newest" {{ currentSort == 'newest' ? 'selected' }}>Newest First</option>
                        <option value="oldest" {{ currentSort == 'oldest' ? 'selected' }}>Oldest First</option>
                        <option value="priority_high" {{ currentSort == 'priority_high' ? 'selected' }}>Priority: High</option>
                        <option value="priority_low" {{ currentSort == 'priority_low' ? 'selected' }}>Priority: Low</option>
                        <option value="status" {{ currentSort == 'status' ? 'selected' }}>Status</option>
                    </select>
                </form>

                {% if currentQuery or currentSort != 'newest' %}
                    <div class="vr mx-2 h-50 d-none d-lg-block opacity-10"></div>
                    <a href="{{ path('admin_ticket_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3 border-0 bg-light-hover transition-all">
                        <i class="fas fa-undo-alt me-1"></i> Reset
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="bg-light">
                    <tr>
                        <th>Ticket Info</th>
                        <th>Reporter</th>
                        <th>Priority & Domain</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="fw-bold text-dark">{{ ticket.title }}</div>
                                    {% if ticket.isSpam %}
                                        <span class="badge bg-danger rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                                            <i class="fas fa-exclamation-triangle"></i> SPAM
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="small text-muted">{{ ticket.createdAt|date('d/m/Y H:i') }}</div>
                            </td>
                            <td>
                                <div>{{ ticket.user.firstname }} {{ ticket.user.lastname }}</div>
                                <div class="small text-muted">{{ ticket.user.email }}</div>
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-{{ ticket.priority.getBadgeClass() }} me-1">{{ ticket.priority.getLabel() }}</span>
                                <span class="badge rounded-pill bg-light text-dark border">{{ ticket.domain.getLabel() }}</span>
                            </td>
                            <td>
                                <span class="badge bg-{{ ticket.status.getBadgeClass() }}">{{ ticket.status.getLabel() }}</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a href="{{ path('admin_ticket_show', {id: ticket.id}) }}" class="btn btn-outline-info btn-sm" title="Creative View">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="{{ path('admin_ticket_edit', {id: ticket.id}) }}" class="btn btn-outline-primary btn-sm" title="Edit with AI">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-ticket-alt d-block fs-1 mb-2 opacity-25"></i>
                                No tickets found in the system.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
