{% extends 'base_back.html.twig' %}

{% block title %}{{ event.nom|translate }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'admin.event_details'|trans }}: {{ event.nom|translate }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">
            {% if event.image %}
                <div class="mb-3">
                    <img src="{{ asset(event.image) }}" alt="{{ event.nom|translate }}" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;">
                </div>
            {% endif %}
            <dl class="row">
                <dt class="col-sm-2">{{ 'common.title'|trans }}</dt>
                <dd class="col-sm-10">{{ event.nom|translate }}</dd>

                <dt class="col-sm-2">{{ 'common.description'|trans }}</dt>
                <dd class="col-sm-10">{{ event.description|translate|nl2br }}</dd>

                <dt class="col-sm-2">{{ 'events.location'|trans }}</dt>
                <dd class="col-sm-10">{{ event.lieu|translate }}</dd>

                <dt class="col-sm-2">{{ 'events.capacity'|trans }}</dt>
                <dd class="col-sm-10">{{ event.capacite }}</dd>

                <dt class="col-sm-2">{{ 'events.start'|trans }}</dt>
                <dd class="col-sm-10">{{ event.dateDebut ? event.dateDebut|date('d/m/Y H:i') : '—' }}</dd>

                <dt class="col-sm-2">{{ 'events.end'|trans }}</dt>
                <dd class="col-sm-10">{{ event.dateFin ? event.dateFin|date('d/m/Y H:i') : '—' }}</dd>

                {% if event.latitude is not null or event.longitude is not null %}
                    <dt class="col-sm-2">{{ 'admin.coordinates'|trans }}</dt>
                    <dd class="col-sm-10">{{ event.latitude }}, {{ event.longitude }}</dd>
                {% endif %}

                {% if event.sponsors|length > 0 %}
                    <dt class="col-sm-2">{{ 'events.sponsors'|trans }}</dt>
                    <dd class="col-sm-10">
                        <ul class="list-unstyled mb-0">
                            {% for sponsor in event.sponsors %}
                                <li><a href="{{ path('admin_sponsors_show', { id: sponsor.id }) }}">{{ sponsor.nom|translate }}</a></li>
                            {% endfor %}
                        </ul>
                    </dd>
                {% endif %}
            </dl>
            <div class="d-flex gap-2 flex-wrap">
                <a href="{{ path('admin_events_edit', { id: event.id }) }}" class="btn btn-primary">{{ 'common.edit'|trans }}</a>
                <a href="{{ path('admin_events_index') }}" class="btn btn-outline-secondary">{{ 'common.back_to_list'|trans }}</a>
                <form method="post" action="{{ path('admin_events_delete', { id: event.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.events.delete_confirm'|trans }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                    <button type="submit" class="btn btn-outline-danger">{{ 'common.delete'|trans }}</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
