{% extends 'base_back.html.twig' %}

{% block title %}{{ 'common.events'|trans }} - Admin EcoSpot{% endblock %}
{% block page_title %}{{ 'common.events'|trans }}{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>{{ 'admin.events.list'|trans }}</span>
            <a href="{{ path('admin_events_new') }}" class="btn btn-primary btn-sm">{{ 'admin.events.new'|trans }}</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>{{ 'common.id'|trans }}</th>
                            <th>{{ 'common.title'|trans }}</th>
                            <th>{{ 'events.location'|trans }}</th>
                            <th>{{ 'events.start'|trans }}</th>
                            <th>{{ 'events.capacity'|trans }}</th>
                            <th width="180">{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td>{{ event.id }}</td>
                                <td>{{ event.nom|translate }}</td>
                                <td>{{ event.lieu|translate }}</td>
                                <td>{{ event.dateDebut ? event.dateDebut|date('d/m/Y H:i') : '—' }}</td>
                                <td>{{ event.capacite }}</td>
                                <td>
                                    <a href="{{ path('admin_events_show', { id: event.id }) }}" class="btn btn-outline-secondary btn-sm">{{ 'common.view'|trans }}</a>
                                    <a href="{{ path('admin_events_edit', { id: event.id }) }}" class="btn btn-outline-primary btn-sm">{{ 'common.edit'|trans }}</a>
                                    <form method="post" action="{{ path('admin_events_delete', { id: event.id }) }}" class="d-inline" onsubmit="return confirm('{{ 'admin.events.delete_confirm'|trans }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'common.delete'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">{{ 'admin.events.no_events'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
