{% extends 'base_back.html.twig' %}

{% block title %}Events - Admin EcoSpot{% endblock %}
{% block page_title %}Events{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Event list</span>
            <a href="{{ path('admin_events_new') }}" class="btn btn-primary btn-sm">New event</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Start date</th>
                            <th>Capacity</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in pagination %}
                            <tr>
                                <td>{{ event.id }}</td>
                                <td>{{ event.nom }}</td>
                                <td>{{ event.lieu }}</td>
                                <td>{{ event.dateDebut ? event.dateDebut|date('d/m/Y H:i') : '—' }}</td>
                                <td>{{ event.capacite }}</td>
                                <td>
                                    <a href="{{ path('admin_events_show', { id: event.id }) }}" class="btn btn-outline-secondary btn-sm">View</a>
                                    <a href="{{ path('admin_events_edit', { id: event.id }) }}" class="btn btn-outline-primary btn-sm">Edit</a>
                                    <form method="post" action="{{ path('admin_events_delete', { id: event.id }) }}" class="d-inline" onsubmit="return confirm('Delete this event?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No events yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white py-3">
            <div class="d-flex justify-content-center">
                {{ knp_pagination_render(pagination) }}
            </div>
        </div>
    </div>

{% endblock %}
